          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{97CBC3A4-645D-453D-8DCA-89BCBE9F478D}"
              SQLTask:SqlStatementSource="DELETE t&#xA;FROM dw.plasma.DimDonors t&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM stage.[Plasma].[Tbl_Donors] ii&#xA;    WHERE t.Donor_ID=ii.Donor_ID   &#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
