                    <output
                      refId="Package\FactDonation\Update\OLE DB Destination.Outputs[OLE DB Destination Error Output]"
                      exclusionGroup="1"
                      isErrorOut="true"
                      name="OLE DB Destination Error Output"
                      synchronousInputId="Package\FactDonation\Update\OLE DB Destination.Inputs[OLE DB Destination Input]">
