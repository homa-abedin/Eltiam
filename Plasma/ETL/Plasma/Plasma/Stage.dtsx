          DTS:LocaleID="-1"
          DTS:ObjectName="Insert"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{97CBC3A4-645D-453D-8DCA-89BCBE9F478D}"
              SQLTask:SqlStatementSource="      insert into [stage].[Plasma].[Tbl_D_Tests]&#xA;(  [Test_ID]&#xA;      ,[Donation_ID]&#xA;      ,[TestType_ID]&#xA;      ,[Lab_Delivery_Date_Repeat]&#xA;      ,[TestDate]&#xA;      ,[result_num]&#xA;      ,[Result_po_negative]&#xA;      ,[Result_Confirm]&#xA;      ,[File_Name]&#xA;      ,[repeat_test]&#xA;      ,[Save_User_ID]&#xA;      ,[Save_Date]&#xA;      ,[Save_Time]&#xA;      ,[LastUpdate_UserID]&#xA;      ,[LastUpdate_Date]&#xA;      ,[LastUpdate_Time]&#xA;&#x9;  ,[isinsert]&#xA;      ,[isupdate]&#xA;    )                  &#xA;   select&#xA;   [Test_ID]&#xA;      ,[Donation_ID]&#xA;      ,[TestType_ID]&#xA;      ,[Lab_Delivery_Date_Repeat]&#xA;      ,[TestDate]&#xA;      ,[result_num]&#xA;      ,[Result_po_negative]&#xA;      ,[Result_Confirm]&#xA;      ,[File_Name]&#xA;      ,[repeat_test]&#xA;      ,[Save_User_ID]&#xA;      ,[Save_Date]&#xA;      ,[Save_Time]&#xA;      ,[LastUpdate_UserID]&#xA;      ,[LastUpdate_Date]&#xA;      ,[LastUpdate_Time]&#xA; ,1&#xA; ,null&#xA;&#xA;   FROM [192.168.1.100].[Plasma].[dbo].[Tbl_D_Tests]    Donors&#xA;where &#xA;not exists(&#xA; select Test_ID from [stage].Plasma.[Tbl_D_Tests] z1 where z1.Test_ID  = Donors.Test_ID   )" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Test\update"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{ac21622f-0ae0-473c-9098-c23d30703ac5}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="update"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{97CBC3A4-645D-453D-8DCA-89BCBE9F478D}"
              SQLTask:SqlStatementSource="DECLARE @date VARCHAR(10) =&#xA;(&#xA;    SELECT Jalali&#xA;    FROM dimdate&#xA;    WHERE [date] = CAST(GETDATE() AS DATE)&#xA;);&#xA;&#xA;TRUNCATE TABLE [Stage].[dbo].[Updates];&#xA;&#xA;INSERT INTO [Stage].[dbo].[Updates] (id)&#xA;SELECT sc.Test_ID&#xA;FROM [Plasma].[Tbl_D_Tests] c&#xA;INNER JOIN [192.168.1.100].[Plasma].[dbo].[Tbl_D_Tests] sc&#xA;    ON sc.Test_ID  &#xA;     = c.Test_ID   &#xA;WHERE&#xA;      sc.LastUpdate_Date COLLATE Latin1_General_CI_AS&#xA;    &lt;&gt; c.LastUpdate_Date  COLLATE Latin1_General_CI_AS&#xA;   OR @date = sc.LastUpdate_Date COLLATE Latin1_General_CI_AS;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
