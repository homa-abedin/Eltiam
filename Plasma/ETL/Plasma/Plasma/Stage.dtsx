              SQLTask:SqlStatementSource="    delete ft &#xA;  from [stage].[Plasma].[Tbl_donations] ft&#xA; inner join (select * from [stage].[dbo].updates) tft1 on tft1.[id]=ft.Donation_ID&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
