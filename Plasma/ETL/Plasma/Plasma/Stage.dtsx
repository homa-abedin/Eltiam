                          errorOrTruncationOperation="Conversion"
                          errorRowDisposition="FailComponent"
                          externalMetadataColumnId="Package\FactDonation\Update\OLE DB Source.Outputs[OLE DB Source Output].ExternalColumns[bloodpressure_Min]"
                          lineageId="Package\FactDonation\Update\OLE DB Source.Outputs[OLE DB Source Output].Columns[bloodpressure_Min]"
                          name="bloodpressure_Min"
