          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{97CBC3A4-645D-453D-8DCA-89BCBE9F478D}"
              SQLTask:SqlStatementSource="DELETE t&#xA;FROM [Plasma].[Tbl_D_Tests] t&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM [192.168.1.100].[Plasma].[dbo].[Tbl_D_Tests] ii&#xA;    WHERE ii.Test_ID --COLLATE Latin1_General_CI_AS&#xA;        = t.Test_ID  --COLLATE Latin1_General_CI_AS&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Test\Delete T"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{18786e31-bcb1-41a0-a3b0-5ef1d33a3270}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Delete T"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{97CBC3A4-645D-453D-8DCA-89BCBE9F478D}"
              SQLTask:SqlStatementSource="     delete ft &#xA;  from [stage].[Plasma].[Tbl_D_Tests] ft&#xA; inner join (select * from [stage].[dbo].updates) tft1 on tft1.[id]=ft.Test_ID" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Test\Insert"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{1a168a53-e3bf-444e-9a6b-bb7f9b7cf9cf}"
