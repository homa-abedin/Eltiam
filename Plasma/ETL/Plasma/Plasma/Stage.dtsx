              SQLTask:SqlStatementSource="&#xA;   &#xA;      insert into [stage].[Plasma].Tbl_Donors&#xA;(  [Donor_ID]&#xA;      ,[Name]&#xA;      ,[Lastname]&#xA;      ,[Latin_Name]&#xA;      ,[Latin_lastName]&#xA;      ,[Father_Name]&#xA;      ,[Latin_FatherName]&#xA;      ,[BirthDate]&#xA;      ,[National_Code]&#xA;      ,[Num_ID]&#xA;      ,[Weight]&#xA;      ,[Job]&#xA;      ,[educate_Grade]&#xA;      ,[Sex]&#xA;      ,[Tell]&#xA;      ,[Mobile]&#xA;      ,[Codeposti]&#xA;      ,[Address]&#xA;      ,[LatinAddress]&#xA;      ,[ID_Card1]&#xA;      ,[ID_Card2]&#xA;      ,[ID_Card3]&#xA;      ,[Card_Type1]&#xA;      ,[Card_Type2]&#xA;      ,[Card_Type3]&#xA;      ,[Introduce_PersonelID]&#xA;      ,[EndCooperation]&#xA;      ,[Donation_Times]&#xA;      ,[Referral_Times]&#xA;      ,[Acount_bank]&#xA;      ,[Save_User_ID]&#xA;      ,[Save_Date]&#xA;      ,[Save_Time]&#xA;      ,[LastUpdate_UserID]&#xA;      ,[LastUpdate_Date]&#xA;      ,[LastUpdate_Time]&#xA;      ,[isinsert]&#xA;      ,[isupdate])                  &#xA;   select&#xA;   [Donor_ID]&#xA;      ,[Name]&#xA;      ,[Lastname]&#xA;      ,[Latin_Name]&#xA;      ,[Latin_lastName]&#xA;      ,[Father_Name]&#xA;      ,[Latin_FatherName]&#xA;      ,[BirthDate]&#xA;      ,[National_Code]&#xA;      ,[Num_ID]&#xA;      ,[Weight]&#xA;      ,[Job]&#xA;      ,[educate_Grade]&#xA;      ,[Sex]&#xA;      ,[Tell]&#xA;      ,[Mobile]&#xA;      ,[Codeposti]&#xA;      ,[Address]&#xA;      ,[LatinAddress]&#xA;      ,[ID_Card1]&#xA;      ,[ID_Card2]&#xA;      ,[ID_Card3]&#xA;      ,[Card_Type1]&#xA;      ,[Card_Type2]&#xA;      ,[Card_Type3]&#xA;      ,[Introduce_PersonelID]&#xA;      ,[EndCooperation]&#xA;      ,[Donation_Times]&#xA;      ,[Referral_Times]&#xA;      ,[Acount_bank]&#xA;      ,[Save_User_ID]&#xA;      ,[Save_Date]&#xA;      ,[Save_Time]&#xA;      ,[LastUpdate_UserID]&#xA;      ,[LastUpdate_Date]&#xA;      ,[LastUpdate_Time]&#xA;&#x9;,1&#xA;&#x9;,null&#xA;&#xA;   FROM [192.168.1.100].[Plasma].[dbo].Tbl_Donors    Donors&#xA;where &#xA;not exists(&#xA; select Donor_ID from [stage].Plasma.Tbl_Donors z1 where z1.Donor_ID  = Donors.Donor_ID COLLATE Latin1_General_CI_AS)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
