              SQLTask:Connection="{97CBC3A4-645D-453D-8DCA-89BCBE9F478D}"
              SQLTask:SqlStatementSource=" DECLARE @date VARCHAR(10) =&#xA;(&#xA;    SELECT Jalali&#xA;    FROM dimdate&#xA;    WHERE [date] = CAST(GETDATE() AS DATE)&#xA;);&#xA;&#xA;TRUNCATE TABLE [Stage].[dbo].[Updates];&#xA;&#xA;INSERT INTO [Stage].[dbo].[Updates] (id)&#xA;SELECT sc.Donor_ID&#xA;FROM [Plasma].Tbl_Donors c&#xA;INNER JOIN [192.168.1.100].[Plasma].[dbo].Tbl_Donors sc&#xA;    ON sc.Donor_ID COLLATE Latin1_General_CI_AS&#xA;     = c.Donor_ID  COLLATE Latin1_General_CI_AS&#xA;WHERE&#xA;      sc.LastUpdate_Date COLLATE Latin1_General_CI_AS&#xA;    &lt;&gt; c.LastUpdate_Date  COLLATE Latin1_General_CI_AS&#xA;   OR @date = sc.LastUpdate_Date COLLATE Latin1_General_CI_AS;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
