                <component
                  refId="Package\FactDonation\Insert\OLE DB Source"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT  
		--IDENTITY(int,1,1) AS Id,
		[Donation_ID]
      ,dd.id as DonorID
      ,[TestResult]
      ,null as [TestResult_text]
      ,[Heartbeat]
      ,[bloodpressure_Min]
      ,[bloodpressure_Max]
      ,[BodyTemprature]
      ,[Bloodstream_confirm]
      ,[Questionnaire_Confirm]
      ,[pupil_confirm]
      ,[behavior_confirm]
      ,[HB_Reciption1_Sys]
      ,[HB_Reciption2_Sys]
      ,[RBC1]
      ,[RBC2]
      ,[WBC1]
      ,[WBC2]
      ,[PLT1]
      ,[PLT2]
      ,[MCV1]
      ,[MCV2]
      ,[MCHC1]
      ,[MCHC2]
      ,[HCT1]
      ,[HCT2]
      ,[HB_Reciption1_Hemo]
      ,[HB_Reciption2_Hemo]
      ,REPLACE( d.[Reciption_Date], '/', '')[Reciption_Date]
      ,dt.Id as [Reciption_Time]
      ,[HB_Medic]
      ,[Viro_serum]
		, null as Viro_serum_text
	   ,[Plasma]
      ,case when Plasma =1 then N'اهدای موفق' when Plasma= 2 then N'تست'  when Plasma= 0 then N'سمپل موفق' when  Plasma= 3 then N' منع اهدا' end as Plasma_Text
      ,[status_physician]
      ,[Device_ID]
      ,[Arm]
	  , case when [Arm] =0 then N'چپ'  when Arm=1 then N'راست' else 'نامشخص'end as arm_text
		, DATEDIFF(
			MINUTE,
			TRY_CONVERT(time(0), NULLIF([Reciption_Time], '')),
			TRY_CONVERT(time(0), NULLIF([Venip_Time], ''))
		) AS Recipt2Venip_Time

		,DATEDIFF(
			MINUTE,
			TRY_CONVERT(time(0), NULLIF([Reciption_Time], '')),
			TRY_CONVERT(time(0), NULLIF([Device_SetTime], ''))
		) AS Recipt2Device_SetTime
		,[Device_SetTime]

		,DATEDIFF(
			MINUTE,
			TRY_CONVERT(time(0), NULLIF([Reciption_Time], '')),
			TRY_CONVERT(time(0), NULLIF([Proc_StartTime], ''))
		) AS Recipt2Proc_StartTime

		,DATEDIFF(
			MINUTE,
			TRY_CONVERT(time(0), NULLIF([Reciption_Time], '')),
			TRY_CONVERT(time(0), NULLIF(Proc_EndTime, ''))
		) AS Recipt2Proc_Proc_EndTime

		,DATEDIFF(
			MINUTE,
			TRY_CONVERT(time(0), NULLIF(Proc_StartTime, '')),
			TRY_CONVERT(time(0), NULLIF(Proc_EndTime, ''))
		) AS start2EndProc
      ,[MedicMass_Plasma]
      ,[DonationMass_plasma]
      ,[Donateloss_blood]
      ,[Heartbeat_release]
      ,[bp_Min_release]
      ,[bp_Max_release]
      ,[BodyTemprature_release]
      ,[Cash_Bon]
      ,[Cash_Total]
      ,[Cash_Donation]
	  ,DATEDIFF(minute,  [Reciption_Time],[release_Time]) Recipt2release_Time
	  ,DATEDIFF(minute,  [Reciption_Time],[Payment_Time]) Recipt2Payment_Time
      ,[Plasma_totalWeight]
      ,[Plasma_btl_weight]
      ,[Plasma_real_volume]
      ,[Product_Manage_Confirm]
      ,[Product_QC_Confirm]
      ,[Product_QP_Confirm]
      ,[Status_Donation]
	  , case when Status_Donation = 9 then N'ناموفق' when Status_Donation=3 then N'موفق' when   Status_Donation is null then 'بدون اقدام' End as Status_Donation_Text
      ,[Donate_successful_status]
      ,[physician_confirm]
      ,[Plasma_Status]
	  , null as [Plasma_Status_Text]
      ,[Donor_health_status]
	  , null as [Donor_health_status_Text]
      ,[Donor_Status]
	  , null as [Donor_Status_Text]
      ,REPLACE( [Save_Date], '/', '') [Save_Date]
      ,[MCH1]
      ,[MCH2]
      ,[CUE]
      ,[UID]
      ,[TC]
      ,[PID]
	  --into dw.plasma.FactDonation
  FROM Stage.Plasma.[Tbl_donations] D
  join (select * from Date..DimTime)dt on dt.Time=left ( d.Reciption_Time,8)
  join (select * from dw.plasma.DimDonors)dd on dd.Donor_ID= d.Donor_ID
  where d.isinsert=1</property>
