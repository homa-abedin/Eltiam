          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{97CBC3A4-645D-453D-8DCA-89BCBE9F478D}"
              SQLTask:SqlStatementSource="&#xA;   &#xA;      insert into [stage].[Plasma].[Tbl_D_Tests]&#xA;(  [Test_ID]&#xA;      ,[Donation_ID]&#xA;      ,[TestType_ID]&#xA;      ,[Lab_Delivery_Date_Repeat]&#xA;      ,[TestDate]&#xA;      ,[result_num]&#xA;      ,[Result_po_negative]&#xA;      ,[Result_Confirm]&#xA;      ,[File_Name]&#xA;      ,[repeat_test]&#xA;      ,[Save_User_ID]&#xA;      ,[Save_Date]&#xA;      ,[Save_Time]&#xA;      ,[LastUpdate_UserID]&#xA;      ,[LastUpdate_Date]&#xA;      ,[LastUpdate_Time]&#xA;&#x9;  ,[isinsert]&#xA;      ,[isupdate]&#xA;    )                  &#xA;   select&#xA;   [Test_ID]&#xA;      ,[Donation_ID]&#xA;      ,[TestType_ID]&#xA;      ,[Lab_Delivery_Date_Repeat]&#xA;      ,[TestDate]&#xA;      ,[result_num]&#xA;      ,[Result_po_negative]&#xA;      ,[Result_Confirm]&#xA;      ,[File_Name]&#xA;      ,[repeat_test]&#xA;      ,[Save_User_ID]&#xA;      ,[Save_Date]&#xA;      ,[Save_Time]&#xA;      ,[LastUpdate_UserID]&#xA;      ,[LastUpdate_Date]&#xA;      ,[LastUpdate_Time]&#xA; ,null&#xA; ,1&#xA;&#xA;   FROM [192.168.1.100].[Plasma].[dbo].[Tbl_D_Tests]    Donors&#xA;where &#xA;not exists(&#xA; select Test_ID from [stage].Plasma.[Tbl_D_Tests] z1 where z1.Test_ID  = Donors.Test_ID   )" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
