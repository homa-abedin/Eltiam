        <DTS:Executable
          DTS:refId="Package\Donation\update"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{07f4bac6-28c4-4e5d-83bf-f3c0fc1582cf}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="update"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{97CBC3A4-645D-453D-8DCA-89BCBE9F478D}"
              SQLTask:SqlStatementSource="&#xA;&#xA; DECLARE @date VARCHAR(10) =&#xA;(&#xA;    SELECT Jalali&#xA;    FROM dimdate&#xA;    WHERE [date] = CAST(GETDATE() AS DATE)&#xA;);&#xA;&#xA;TRUNCATE TABLE [Stage].[dbo].[Updates];&#xA;&#xA;INSERT INTO [Stage].[dbo].[Updates] (id)&#xA;SELECT sc.Donation_ID&#xA;FROM [Plasma].[Tbl_donations] c&#xA;INNER JOIN [192.168.1.100].[Plasma].[dbo].[Tbl_donations] sc&#xA;    ON sc.Donation_ID COLLATE Latin1_General_CI_AS&#xA;     = c.Donation_ID  COLLATE Latin1_General_CI_AS&#xA;WHERE&#xA;      sc.LastUpdate_Date COLLATE Latin1_General_CI_AS&#xA;    &lt;&gt; c.LastUpdate_Date  COLLATE Latin1_General_CI_AS&#xA;   OR @date = sc.LastUpdate_Date COLLATE Latin1_General_CI_AS;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
