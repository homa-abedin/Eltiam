          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{97CBC3A4-645D-453D-8DCA-89BCBE9F478D}"
              SQLTask:SqlStatementSource="DELETE t&#xA;FROM [Plasma].[Tbl_donations] t&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM [192.168.1.100].[Plasma].[dbo].[Tbl_donations] ii&#xA;    WHERE ii.Donation_ID COLLATE Latin1_General_CI_AS&#xA;        = t.Donation_ID  COLLATE Latin1_General_CI_AS&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
