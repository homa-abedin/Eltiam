      {
        "name": "Bin Index",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Value",
            "dataType": "int64",
            "isNameInferred": false,
            "isDataTypeInferred": true,
            "sourceColumn": "[Value]"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "GENERATESERIES(1, 10, 1)"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Bin Size",
            "expression": [
              "",
              "DIVIDE(",
              "    [Max Donations Per Person] - [Min Donations Per Person] + 1,",
              "    10",
              ")"
            ]
          },
          {
            "name": "Bin Min",
            "expression": [
              "",
              "[Min Donations Per Person]",
              "+ ( SELECTEDVALUE('Bin Index'[Value]) - 1 ) * [Bin Size]"
            ]
          },
          {
            "name": "Bin Max",
            "expression": [
              "",
              "[Min Donations Per Person]",
              "+ SELECTEDVALUE('Bin Index'[Value]) * [Bin Size]",
              ""
            ]
          },
          {
            "name": "Persons in Dynamic Bin",
            "expression": [
              "",
              "VAR BinMin = [Bin Min]",
              "VAR BinMax = [Bin Max]",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT(FactDonation[DonorID]),",
              "    FILTER(",
              "        VALUES(FactDonation[DonorID]),",
              "        [CntSuccessDonation] >= BinMin &&",
              "        [CntSuccessDonation]< BinMax",
              "    )",
              ")",
              ""
            ]
          },
          {
            "name": "Bin Label",
            "expression": [
              "",
              "FORMAT([Bin Min], \"0\") & \" – \" & FORMAT([Bin Max], \"0\")"
            ]
          }
        ]
      }
