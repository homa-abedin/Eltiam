        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/192 168 10 10;DW\",",
                "    plasma_FactDonation = Source{[Schema=\"plasma\",Item=\"FactDonation\"]}[Data]",
                "in",
                "    plasma_FactDonation"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "CNTEntry",
            "expression": [
              " DISTINCTCOUNT(FactDonation[Donation_ID])",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "CntSuccessDonation",
            "expression": [
              " CALCULATE([CNTEntry], FactDonation[Plasma]=1)",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "Max Donations Per Person",
            "expression": [
              "",
              "MAXX(",
              "    VALUES(FactDonation[DonorID]),",
              "    [CntSuccessDonation]",
              ")"
            ]
          },
          {
            "name": "Min Donations Per Person",
            "expression": [
              "",
              "MINX(",
              "    VALUES(FactDonation[DonorID]),",
              "    [CntSuccessDonation]",
              ")"
            ]
          },
          {
            "name": "Persons Above Average Donation",
            "expression": [
              "",
              "VAR AvgDonation = [Average Donation Per Person]",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT(FactDonation[DonorID]),",
              "    FILTER(",
              "        VALUES(FactDonation[DonorID]),",
              "        [CntSuccessDonation] > AvgDonation",
              "    )",
              ")",
              ""
            ]
          },
          {
            "name": "Average Donation Per Person",
            "expression": [
              "",
              "AVERAGEX(",
              "    VALUES(DimDonors[Donor_ID]),",
              "    [CntSuccessDonation]",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "TonPlasma",
            "expression": [
              "DIVIDE(sum(FactDonation[Plasma_totalWeight]),1000)",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "CNTPerson",
            "expression": " DISTINCTCOUNT(FactDonation[DonorID])"
          }
        ]
      },
