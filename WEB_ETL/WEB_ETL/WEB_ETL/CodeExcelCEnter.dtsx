          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7B3F96E3-49ED-4574-9BFB-55862831B175}"
              SQLTask:SqlStatementSource=" INSERT INTO web.behestan_center (center)&#xA;SELECT DISTINCT c2.Center&#xA;FROM [web].behestan c2&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM web.behestan_center c1&#xA;    WHERE c1.center = c2.Center and Center is not null&#xA;) &#xA;and c2.Center is not null&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Create Center Code Excel\HejratCenter"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
