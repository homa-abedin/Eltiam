          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{7B3F96E3-49ED-4574-9BFB-55862831B175}"
              SQLTask:SqlStatementSource=" INSERT INTO web.nokhbegan_center (center)&#xA;SELECT DISTINCT c2.Branch&#xA;FROM [web].Nokhbegan c2&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM web.nokhbegan_center c1&#xA;    WHERE c1.center = c2.Branch and Center is not null&#xA;) &#xA;and c2.Branch is not null&#xA;&#xA;&#xA;Go&#xA;&#xA;delete from web.nokhbegan_center where center =''&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
