          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{A80B0B34-5E8D-4ED1-B76E-7B257A977CBE}"
              SQLTask:SqlStatementSource=" INSERT INTO web.Hejrat_center (center)&#xA;SELECT DISTINCT c2.Center&#xA;FROM [web].hejrat c2&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM web.Hejrat_center c1&#xA;    WHERE c1.center = c2.Center&#xA;) &#xA;order by c2.Center" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
