                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="OLE DB Source"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select 
concat(cast( mp.kharazmi as int) ,'0',trim( batchnumber ) )as Id
,convert (varchar (50) ,sku.BatchNumber)  batchno , mp.kharazmi ProductCode, sku.ExpireAlternateDateKey ExpireDate 
from Eltiam.SLSSalesOrderHeaders h
join ( select *  from eltiam.SLSSalesOrderDetails) d  on d.SalesOrderHeaderKey= h.id 
join (select * from dw..dimproduct where SupplierCode=100) dp on dp.ProductKey= d.ProductKey
join (select * from eltiam.SLSSalesOrderDetailSKUs)ds on  ds.SalesOrderDetailKey= d.id
join(select * from web.MapProduct ) mp on mp.eltiam= dp.ProductCode
join (select * from eltiam.WHSSKUs)sku on sku.Id= ds.SKUKey 
where 
not exists (select * from dw.kharazmi.dimsku s where  s.productcode= mp.kharazmi and sku.batchnumber= s.batchno)and
h.InvoiceDateKey&gt;= 14030101 
group by  sku.BatchNumber, mp.kharazmi, sku.ExpireAlternateDateKey</property>
