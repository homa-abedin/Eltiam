                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select  
cast (concat(cast( map.kharazmi as int) ,isnull (s.batch, '00000000'))as bigint )as Id




,map.kharazmi ProductCode
,isnull (s.batch, '')BatchNo
,isnull( d.date, '2000-01-01')   ExpireDate
--select * 
FROM web.Shaya  s
join (select * from web.MapProduct) map on map.shaya= s.productCode
 join (select * from dimdate)d on  d.Gregorian = FORMAT(CONVERT(date, LEFT(engheza, CHARINDEX(' ', engheza + ' ') - 1), 101), 'yyyy/MM/dd')
where not exists (select * from dw.[kharazmi].[DimSKU] sk where sk.ProductCode= map.kharazmi and s.batch =isnull(sk.BatchNo, '') )
group  by  map.kharazmi, s.batch , d.date</property>
