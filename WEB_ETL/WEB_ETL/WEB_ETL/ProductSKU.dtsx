                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select concat(cast( map.kharazmi as int) ,'0',trim( batchNumber ) )as Id
,map.kharazmi ProductCode , sku.batchNumber BatchNo,ExpireDate ExpireDate 
  from Stage.web.Momtaz_SKUs  sku
 join (select * from web.Momtaz_Products) p on p.productKey=sku.productKey
 join (select * from web.mapproduct   )map on map.momtaz= p.productCode
 where not exists (select * from dw.[kharazmi].[DimSKU] sk where sk.ProductCode=map.kharazmi and sk.BatchNo=sku.batchNumber )
group  by map.kharazmi, sku.batchNumber, ExpireDate</property>
