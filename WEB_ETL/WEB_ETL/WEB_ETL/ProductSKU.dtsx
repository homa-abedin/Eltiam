                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select  
concat(cast( map.kharazmi as int) ,'0',trim(cast( Batch as varchar(8)) )) as Id




,map.kharazmi ProductCode, s.batch,  d.date   ExpireDate
--select * 
FROM web.behestan  s
join (select * from web.MapProduct) map on map.behestan= s.productCode
join (select * from dimdate)d on REPLACE( d.Gregorian, '/','') = ExpireDate
where not exists (select * from dw.[kharazmi].[DimSKU] sk where sk.ProductCode= map.kharazmi and s.batch=sk.BatchNo )
group  by  map.kharazmi, batch, d.date</property>
