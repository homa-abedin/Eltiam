                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">UPDATE Web.Toba_Inventory
SET SerialNo = dw.dbo.fn_KeepNumbers(SerialNo);

delete from  web.Toba_Inventory
where len(invProductID ) &lt;7

select  
concat(cast( map.kharazmi as int) ,'0',trim( SerialNo ) )as Id
,map.kharazmi ProductCode, s.SerialNo BatchNo,cast( ExpireDate as  date)ExpireDate


FROM web.Toba_Inventory  s
join (select distinct toba, kharazmi from web.MapProduct) map on  map.toba   =convert (float, s.invProductID)

where not exists (select * from dw.[kharazmi].[DimSKU] sk where sk.ProductCode= map.kharazmi and s.SerialNo=sk.BatchNo )
group  by  map.kharazmi, SerialNo, ExpireDate</property>
