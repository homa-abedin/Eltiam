                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">UPDATE Web.Toba_CustomerSales
SET BatchNumber = dw.dbo.fn_KeepNumbers(BatchNumber);

 


select  
concat(cast( map.kharazmi as int) ,'0',trim( BatchNumber ) )as Id
,map.kharazmi ProductCode, s.BatchNumber BatchNo,cast( ExpireDate as  date)ExpireDate
FROM web.Toba_CustomerSales  s
join (select * from web.MapProduct) map on map.toba= s.ProductId

where not exists (select * from dw.[kharazmi].[DimSKU] sk where sk.ProductCode= map.kharazmi and s.BatchNumber=sk.BatchNo )
group  by  map.kharazmi, BatchNumber, ExpireDate</property>
