                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select  
concat(cast( map.kharazmi as int) ,'0',trim( Batch ) )as Id
,map.kharazmi ProductCode , s.Batch BatchNo,cast ( d.Date as varchar(10)) ExpireDate

--select * 
FROM web.Razi_Inventory  s
join (select * from web.MapProduct) map on map.razi= s.ProductCode
join (select date, datekey from dimdate)d on d.datekey= s.ExpirationDate
where not exists (select * from dw.[kharazmi].[DimSKU] sk where sk.ProductCode= map.kharazmi and sk.BatchNo=s.Batch )
group  by  map.kharazmi, s.Batch, d.Date</property>
