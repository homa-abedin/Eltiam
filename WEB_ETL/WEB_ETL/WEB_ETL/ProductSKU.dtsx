                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select  
concat(cast( map.kharazmi as int) ,'0',trim( BatchNo ) )as Id
,map.kharazmi ProductCode, s.BatchNo,  d.date   ExpireDate
--select * 
FROM web.samen_CustomerSales  s
join (select * from web.MapProduct) map on map.samen= s.productCode
join (select * from dimdate)d on REPLACE( d.Gregorian, '/','') = ExpireDate
where not exists (select * from dw.[kharazmi].[DimSKU] sk where sk.ProductCode= map.kharazmi and s.BatchNo=sk.BatchNo )
group  by  map.kharazmi, BatchNo, d.date</property>
