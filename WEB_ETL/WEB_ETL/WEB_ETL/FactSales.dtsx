          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\FactSalesWeb\FactSalesWeb\Alborz"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Alborz"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
1 as type,
s.BillShamsiDate
    ,s.ShomarehFaktor  as SalesID,
     s.Quantity  ,
     cast(  s.Quantity *Price as decimal(18,2)) as  price ,
      0 isprize,
      sku.id batchID,
    dc.Id as centerid,
    isnull(s.GLN,12000)GLN,
	p.kharazmi productcode
	--, s.ExpireDate
    --COALESCE(c.GTIN, v.Valid_GTIN) AS GTIN -- پر کردن NULLها,
	,N'alborz' as pakhsh, 12000 as  [valuepakhsh]
	--select * 
FROM web.Alborz_CustomerSales  s
JOIN (select * from dw.kharazmi.DimCenterPakhsh) dc ON dc.Alborz = s.CenterCode
join (select distinct kharazmi, alborz from web.mapproduct) p on p.alborz= s.ProductCode
join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno=isnull( s.BatchNo, '')

WHERE SaleType=1
and IsInsert=1</property>
                    <property
