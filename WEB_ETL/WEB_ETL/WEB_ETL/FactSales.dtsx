                <component
                  refId="Package\FactSalesWeb\FactSalesWeb\Ferdos"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Ferdos"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">delete 
from stage.Web.ferdows_CustomerSales  
where productCode is null
 


select 
1 as type
,0 as isprize
,invoiceNo
,invoiceDate 
,c.Id as centerid
,p.kharazmi productcode
,GLN
,Quantity
,sku.id batchID 
,productPrice as Price
, N'ferdos' as pakhsh
, 1000 as valuepakhsh
--select *
from stage.Web.ferdows_CustomerSales s 
join (select * from web.mapproduct) p on p.ferdos= s.ProductCode
join dw.kharazmi.DimCenterPakhsh c 
on c.ferdos='1'+RIGHT('000' + CAST(s.centerWarehouseId AS VARCHAR(3)), 3)  +RIGHT('0000' + CAST(s.warehouseId AS VARCHAR(4)), 4) 
join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= s.BatchNo

where documentTypeId=20
and isinsert=1
 union all
 select 
1 as type
,1 as isprize
,invoiceNo
,invoiceDate 
,c.Id as centerid
,p.kharazmi productcode
,GLN
,Quantity
,sku.id batchID 
,productPrice as Price
,N'ferdos' as pakhsh
,1000 as valuepakhsh
--select * 
from stage.Web.ferdows_CustomerSales s 
join (select * from web.mapproduct) p on p.ferdos= s.ProductCode
join dw.kharazmi.DimCenterPakhsh c
on c.ferdos='1'+RIGHT('000' + CAST(s.centerWarehouseId AS VARCHAR(3)), 3)  +RIGHT('0000' + CAST(s.warehouseId AS VARCHAR(4)), 4) 
join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= s.BatchNo
where documentTypeId=26
and isinsert=1</property>
