                  description="OLE DB Source"
                  name="Momtaz1404"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select 

pc.kharazmi productcode
, sku1.id batchID,cu.gln, cp.id centerid, quantity,convert (decimal(18,2),  price*quantity)   as Price ,  invoiceNumber  invoiceNumber1
--, sku.expireDate  ExpireDate
, dateKey, N'Momtaz' as pakhsh , 48000  as valuepakhsh , 0 as  isprize
--select *
from stage.web.Momtaz_SalesNew s
 join (select * from web.Momtaz_Products) p on p.productKey= s.productKey

 join (select * from web.mapproduct) pc on pc.momtaz= p.productcode
join (select * from Stage.web.Momtaz_SKUs) sku on sku.skuKey= s.skuKey
join (select * from Stage.web.Momtaz_Customer) cu on cu.customerKey=s.customerKey
join dw.kharazmi.DimCenterPakhsh  cp on cp.momtaz1404 = s.centerKey
join (select * from dw.kharazmi.dimsku)sku1 on sku1.productcode=  pc.kharazmi and sku1.batchno= sku.batchNumber


where isinsert=1</property>
                    <property
                      dataType="System.String"
                      description="The variable that contains the SQL command to be executed."
                      name="SqlCommandVariable"></property>
