                <component
                  refId="Package\FactSalesWeb\FactSalesWeb\Qasem"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Qasem"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">delete from web.Qhasem_CustomerSales
where IsPrize= 0 and Price=0 and Quantity=0



SELECT
1 as type, 
s.FactorDate
    ,s.FactorID,
    s.Quantity,
	s.Price, 
      0   as  isprize,
      sku.id batchID,
    dc.Id as centerid,
    s.GLN,
    p.kharazmi productcode -- پر کردن NULLها
	,N'Qhasem' as pakhsh, 29000 as  [valuepakhsh]
	--, d.Date ExpireDate
    --s.ProductId
	--select * 
FROM web.Qhasem_CustomerSales  s
JOIN (select * from dw.kharazmi.DimCenterPakhsh) dc ON dc.Qasem = s.CenterCode
join (select distinct kharazmi, qasem from web.mapproduct) p on p.qasem= s.ProductCode
--join price pr on pr.ProductCode= p.qasem and pr.FactorID= s.FactorID and pr.FactorDate= s.FactorDate
join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= s.BatchNumber


join (select * from dimdate)d on d.datekey=s.ExpireDate
WHERE RecordType like N'فاکتور اصلي'
and IsInsert=1
and IsPrize=0


union all 

SELECT
1 as type, 
s.FactorDate
,s.FactorID,
s.Quantity,
 s.Price   , 
1   as  isprize,
sku.id batchID,
dc.Id as centerid,
s.GLN,
p.kharazmi productcode -- پر کردن NULLها
,N'Qhasem' as pakhsh, 29000 as  [valuepakhsh]
--, d.Date ExpireDate
--s.ProductId
--select * 
FROM web.Qhasem_CustomerSales  s
JOIN (select * from dw.kharazmi.DimCenterPakhsh) dc ON dc.Qasem = s.CenterCode
join (select distinct kharazmi, qasem from web.mapproduct) p on p.qasem= s.ProductCode
join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= s.BatchNumber


join (select * from dimdate)d on d.datekey=s.ExpireDate
WHERE RecordType like N'فاکتور اصلي'
and IsInsert=1
and IsPrize=1</property>
