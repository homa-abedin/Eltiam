                <component
                  refId="Package\FactSalesWeb\FactSalesWeb\Barij"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Barij"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">--with price as (
--select convert (decimal (18,0) ,sum(Price/Quantity))price , ProductCode, ShomarehFaktor, Date from web.Barij_CustomerSales
--where Bonus=0
--group by ProductCode, ShomarehFaktor, Date
--)

SELECT 
1 as type,
s.Date
    ,s.ShomarehFaktor  as SalesID,
     s.Quantity  as Quantity,
      s.NetPrice  as priceall,
      0 as isprize,
     sku.id batchid,
    dc.Id as centerid,
    s.GLN,
    p.kharazmi productcode -- پر کردن NULLها
	,N'Barij' as pakhsh, 69319 as  [valuepakhsh]
	
	--select * 
FROM web.Barij_CustomerSales  s
JOIN (select * from dw.kharazmi.DimCenterPakhsh) dc ON dc.Barij = s.CenterCode
 join (select  distinct kharazmi, barij from web.mapproduct) p on p.barij= s.ProductCode
--join price pr on pr.ProductCode= p.barij and pr.ShomarehFaktor= s.ShomarehFaktor and pr.Date= s.Date  and s.ProductCode=pr.ProductCode
 join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= ''
WHERE Quantity&lt;&gt;0
and IsInsert=1

union all

SELECT 
	1 as type,
	s.Date
	,s.ShomarehFaktor  as SalesID,
	s.Bonus  as Quantity,
	s.NetPrice  as priceall,
	1 as isprize,
	sku.id batchid,
	dc.Id as centerid,
	s.GLN,
	p.kharazmi productcode -- پر کردن NULLها
	,N'Barij' as pakhsh, 69319 as  [valuepakhsh]
	
	--select * 
FROM web.Barij_CustomerSales  s
JOIN (select * from dw.kharazmi.DimCenterPakhsh) dc ON dc.Barij = s.CenterCode
 join (select * from web.mapproduct) p on p.barij= s.ProductCode
--join price pr on pr.ProductCode= p.barij and pr.ShomarehFaktor= s.ShomarehFaktor and pr.Date= s.Date  and s.ProductCode=pr.ProductCode
 join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= ''
WHERE Bonus&lt;&gt;0
and IsInsert=1</property>
