                <component
                  refId="Package\FactSalesWeb\FactSalesWeb\Daya"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Daya"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">delete FROM web.Daya_CustomerSales  
where ProductName is null


SELECT 
1 as type,
    s.Factordate,
    s.Quantity,
    s.Price  ,
    s.IsPrize,
      sku.id batchID,
    dc.Id as centerid,
    s.Gln,
	 --d.Date ExpireDate,
    p.kharazmi  productcode-- پر کردن NULLها
	,N'Daya' as pakhsh, 69238 as  [valuepakhsh]
    --s.ProductId
	--select * 
FROM web.Daya_CustomerSales s
JOIN (select * from  dw.kharazmi.DimCenterPakhsh) dc ON dc.Daya = s.CenterId
 join (select   distinct daya , kharazmi  from web.mapproduct) p on p.daya= s.ProductId
 join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= s.BatchNumber
join (select * from dimdate)d on REPLACE(Gregorian, '/','')=REPLACE( s.ExpireDate,'-' , '')+'01'
WHERE s.RecordTypeId = 1
and IsInsert=1</property>
