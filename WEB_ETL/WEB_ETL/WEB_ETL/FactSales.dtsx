                <component
                  refId="Package\FactSalesWeb\FactSalesWeb\Momtaz 1403"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Momtaz 1403"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">--WITH ValidGTINs AS (
--    SELECT
--	ProductCode, max(GTIN) AS Valid_GTIN
--    FROM stage.web.Momtaz_Products
--    WHERE GTIN IS NOT NULL
--    GROUP BY ProductCode
--)


select 
1 as type,
Date
, ShomarehFaktor as ShomarehFaktor1
,0  as isprize
,convert ( int, Quantity ) Quantity
,FinalAmount as price
, dc.id as centerid
,case when isnull(cu.gln ,0)=0 then 48000 else  cu.gln end as gln
,p.kharazmi productcode
,N'Momtaz' as pakhsh, 48000 as valuepakhsh  
,sku.id as batchid

--select *
from stage.web.Momtaz_CustomerSales s
JOIN (select * from dw.kharazmi.DimCenterPakhsh) dc ON dc.momtaz = s.CenterCode
 join (select customerCode, gln from stage.web.Momtaz_Customer group by customerCode, gln)cu on cu.customerCode=s.CustomerCode
 join (select * from web.mapproduct) p on p.momtaz= s.ProductCode
  join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= '-------'

where invOperationCode in (101) and AmountDiscount =0
and IsInsert=1

union all

select 
1 as type,
Date, ShomarehFaktor  as ShomarehFaktor1

,1  as isprize

, cast (AmountDiscount/Price  as int)  Quantity
 ,AmountDiscount as price
, dc.id as centerid
,case when isnull(cu.gln ,0)=0 then 48000 else  cu.gln end as gln
,p.kharazmi productcode
,N'Momtaz' as pakhsh, 48000 as valuepakhsh  
,sku.id as batchid
--select *
from stage.web.Momtaz_CustomerSales s
JOIN (select * from dw.kharazmi.DimCenterPakhsh) dc ON dc.momtaz = s.CenterCode
left join (select customerCode, gln from stage.web.Momtaz_Customer group by customerCode, gln)cu on cu.customerCode=s.CustomerCode
 join (select * from web.mapproduct) p on p.momtaz= s.ProductCode
 join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= '-------'

where invOperationCode in (101) and AmountDiscount &lt;&gt;0
and IsInsert=1</property>
