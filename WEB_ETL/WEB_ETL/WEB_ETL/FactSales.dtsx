                <component
                  refId="Package\FactSalesWeb\FactSalesWeb\Samen"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Samen"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">delete FROM web.samen_CustomerSales  
where ProductName is null


SELECT 
	1 as type,
	s.date,
	s.Quantity,
	cast ( TotalPurePrice as decimal(18,2) )as price ,
	0  IsPrize,
	sku.id batchID,
	dc.Id as centerid,
	s.Customer_GLN,
	--d.Date ExpireDate,
	p.kharazmi  productcode-- پر کردن NULLها
	,N'Same' as pakhsh, 52000 as  [valuepakhsh]
	--s.ProductId
	--select * 
FROM web.samen_CustomerSales s
JOIN (select * from  dw.kharazmi.DimCenterPakhsh) dc ON dc.samen = s.CenterCode
 join (select distinct kharazmi, samen from web.mapproduct) p on p.samen= s.ProductCode
 join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= s.BatchNo
--join (select * from dimdate)d on REPLACE(Gregorian, '/','')=REPLACE( s.ExpireDate,'-' , '')+'01'
WHERE
TotalPurePrice&lt;&gt;0 and
 IsInsert=1


union all


SELECT 
	1 as type,
	s.date,
	s.Quantity,
	 Quantity  * CAST(SellPrice AS DECIMAL(18,2))  as price , 
	1  IsPrize,
	sku.id batchID,
	dc.Id as centerid,
	s.Customer_GLN,
	--d.Date ExpireDate,
	p.kharazmi  productcode-- پر کردن NULLها
	,N'Same' as pakhsh, 52000 as  [valuepakhsh]
	--,s.ProductId
	--select * 
FROM web.samen_CustomerSales s
JOIN (select * from  dw.kharazmi.DimCenterPakhsh) dc ON dc.samen = s.CenterCode
 join (select distinct kharazmi, samen from web.mapproduct) p on p.samen= s.ProductCode
 join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= s.BatchNo
--join (select * from dimdate)d on REPLACE(Gregorian, '/','')=REPLACE( s.ExpireDate,'-' , '')+'01'
WHERE
TotalPurePrice=0 and
 IsInsert=1</property>
