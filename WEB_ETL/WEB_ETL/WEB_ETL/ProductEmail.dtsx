                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select distinct Product, ProductCode, min(DateKey)MinDate,max(DateKey)MaxDate,cast( N'qasem' as nvarchar(15)) as company
