                <component
                  refId="Package\map product_email\map product Inventory\eltiam"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="eltiam"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">with pro as (
select  MIN(kharazmi)kharazmi, eltiam from  stage.web.mapproduct where eltiam is not null group by eltiam
)

select distinct Product, ProductCode,min(InvoiceDateKey)MinDate, max(InvoiceDateKey)MaxDate ,cast( N'eltiam' as nvarchar(15)) as company
	   from  eltiam.SLSSalesOrderDetails D
LEFT JOIN eltiam.SLSSalesOrderHeaders H
	ON H.Id = D.SalesOrderHeaderKey
	join (select * from dw..dimproduct where SupplierCode=100) dp on dp.ProductKey= d.ProductKey
join (select * from eltiam.SLSSalesOrderDetailSKUs)ds on  ds.SalesOrderDetailKey= d.id
left join pro on pro.eltiam= dp.ProductCode

where pro.kharazmi is null
and not exists (select * from web.KasriProduct k where k.ProductCode= d.ProductKey)

and InvoiceDateKey&gt;=14040101
group by Product, ProductCode
having min(InvoiceDateKey)&gt;=14040101</property>
