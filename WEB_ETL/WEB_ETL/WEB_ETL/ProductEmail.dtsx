                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select distinct ProductName, ProductId, min(Factordate)MinDate,max(Factordate)MaxDate,cast( N'toba' as nvarchar(15)) as company
FROM web.Toba_CustomerSales  s
left join (select distinct kharazmi, toba from web.mapproduct) p on  p.toba  = s.ProductId
WHERE p.kharazmi is null
group by ProductName, ProductId
having min(Factordate) &gt;=14040101</property>
