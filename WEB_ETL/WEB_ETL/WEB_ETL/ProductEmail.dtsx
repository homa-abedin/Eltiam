                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select distinct Product, ProductCode, min(DateKey)MinDate,max(DateKey)MaxDate,cast( N'barij' as nvarchar(15)) as company
FROM web.Barij_Inventory  s
left join (select distinct kharazmi, barij from web.mapproduct) p on  p.barij  = s.ProductCode
WHERE p.kharazmi is null
and not exists ( select * from Web.KasriProduct d where d.ProductCode= s.ProductCode)
group by Product, ProductCode
having min(DateKey) &gt;=14040101</property>
