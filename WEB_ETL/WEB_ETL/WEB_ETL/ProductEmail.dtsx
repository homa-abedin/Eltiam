                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select distinct pr.product, pr.productCode, min(dateKey)MinDate,max(dateKey)MaxDate,cast( N'momtaz' as nvarchar(15)) as company
FROM web.Momtaz_InventoryNew  s
join (select * from web.Momtaz_Products) pr on pr.productKey=s.productKey
left join (select distinct kharazmi, momtaz from web.mapproduct) p on  p.momtaz  = pr.productCode
WHERE p.kharazmi is null
and not exists ( select * from Web.KasriProduct d where d.ProductCode= s.productKey)

group by pr.product, pr.productCode
having min(dateKey) &gt;=14040101</property>
