                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select distinct s.ProductName, s.productCode, min(date)MinDate,max(date)MaxDate,cast( N'Nokhbegan' as nvarchar(15)) as company
FROM web.Nokhbegan  s
left join (select distinct kharazmi, Nokhbegan from web.mapproduct) p on  p.Nokhbegan  =s.ProductCode
WHERE p.kharazmi is null 
and not exists ( select * from Web.KasriProduct d where d.ProductCode= s.ProductCode) 
and (InventoryQuantity&lt;&gt;0 or InTransitQuantity&lt;&gt;0 or SalesAmount&lt;&gt;0 or QuantitySold&lt;&gt;0 or ReturnQty&lt;&gt;0)
group by s.ProductName, s.productCode
having min(date) &gt;=14040101
order by ProductName</property>
