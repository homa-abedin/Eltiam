                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select distinct Product, ProductCode, min(BillShamsiDate)MinDate,max(BillShamsiDate)MaxDate , cast( N'alborz' as nvarchar(15)) as company
FROM web.Alborz_CustomerSales  s
left join (select distinct kharazmi, alborz from web.mapproduct) p on p.alborz= s.ProductCode
WHERE p.kharazmi is null
group by Product, ProductCode
having min(BillShamsiDate) &gt;=14040101</property>
