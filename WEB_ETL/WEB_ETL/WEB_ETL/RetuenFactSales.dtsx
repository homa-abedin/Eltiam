                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select 
1 as type
,0 as isprize
,invoiceNo
, invoiceDate 
, c.Id as centerid
, p.kharazmi productcode
,GLN
,abs( Quantity)Quantity
 ,sku.id batchID
,abs (productPrice) as price
, N'ferdos' as pakhsh
, 1000 as valuepakhsh
--select *
from stage.Web.ferdows_CustomerSales s 
join (select * from web.mapproduct) p on p.ferdos= s.ProductCode

join dw.kharazmi.DimCenterPakhsh c 

on c.ferdos='1'+RIGHT('000' + CAST(s.centerWarehouseId AS VARCHAR(3)), 3)  +RIGHT('0000' + CAST(s.warehouseId AS VARCHAR(4)), 4) 
join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= s.BatchNo
where documentTypeId=21 and isinsert=1
 union  all
 select 
1 as type
,1 as isprize
,invoiceNo
, invoiceDate 
, c.Id as centerid
, p.kharazmi
,GLN
,abs( Quantity)Quantity
 ,sku.id batchID
,ABS( productPrice) as price
, N'ferdos' as pakhsh
, 1000 as valuepakhsh
from stage.Web.ferdows_CustomerSales s 
join (select * from web.mapproduct) p on p.ferdos= s.ProductCode

join dw.kharazmi.DimCenterPakhsh c 
on c.ferdos='1'+RIGHT('000' + CAST(s.centerWarehouseId AS VARCHAR(3)), 3)  +RIGHT('0000' + CAST(s.warehouseId AS VARCHAR(4)), 4) 
join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= s.BatchNo

where documentTypeId=27
and isinsert=1</property>
