                <component
                  refId="Package\FactReturnSalesWeb\FactReturnSalesWeb\hejrat"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="hejrat"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select 
1 as type
,0 as isprize
,null invoiceNo
,date invoiceDate 
, c.Id as centerid
, p.kharazmi productcode
, GLN
,abs( Quantity)Quantity
,sku.Id batchID 
,cast (abs (TotalSaleFee) as decimal (18,0) ) as Price
, N'hejrat' as pakhsh
, 27000 as valuepakhsh
--select *
from stage.Web.Hejrat_CustomerSales s 
join (select * from web.mapproduct) p on p.hejrat= s.ProductCode
join dw.kharazmi.DimCenterPakhsh c 
on c.hejrat= s.centercode
join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= ''

where 
DocumentDescription = N'برگشت از فروش'
and  isinsert=1
and TotalSaleFee &lt;&gt; 0

union all

select 
1 as type
,1 as isprize
,null invoiceNo
,date invoiceDate 
, c.Id as centerid
, p.kharazmi productcode
, GLN
,abs( Quantity)Quantity
,sku.Id batchID 
,cast (BuyFee*abs (Quantity) as decimal (18,0) ) as Price
, N'hejrat' as pakhsh
, 27000 as valuepakhsh
--select *
from stage.Web.Hejrat_CustomerSales s 
join (select * from web.mapproduct) p on p.hejrat= s.ProductCode
join dw.kharazmi.DimCenterPakhsh c 
on c.hejrat= s.centercode
join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= ''

where 
DocumentDescription = N'برگشت از فروش'
and  isinsert=1
and TotalSaleFee = 0</property>
