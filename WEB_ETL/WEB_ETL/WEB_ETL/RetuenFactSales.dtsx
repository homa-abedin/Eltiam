                <component
                  refId="Package\FactReturnSalesWeb\FactReturnSalesWeb\momtaz1404"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="momtaz1404"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">delete 
from stage.web.Momtaz_ReturnSalesNew
where productKey is null



select 
2 as type
,p1.kharazmi prductcode
     , sku1.id batchID
,cu.gln
, cp.id centerid
, quantity,convert (decimal(18,2),  price*quantity)   as Price 
, returnNumber as invoicenumber
, dateKey, N'Momtaz' as pakhsh , 48000  as valuepakhsh 
, 0 as  isprize
--select *
from stage.web.Momtaz_ReturnSalesNew s
join Stage.web.Momtaz_Products p on p.productKey=s.productKey
join (select * from web.mapproduct) p1 on p1.momtaz= p.ProductCode

join (select * from Stage.web.Momtaz_SKUs) sku on sku.skuKey= s.skuKey
join Stage.web.Momtaz_Customer cu on cu.customerKey=s.customerKey
join dw.kharazmi.DimCenterPakhsh  cp on cp.momtaz1404 = s.centerKey
join (select * from dw.kharazmi.dimsku)sku1 on sku1.productcode=  p1.kharazmi and sku1.batchno= sku.batchNumber

where isinsert=1</property>
