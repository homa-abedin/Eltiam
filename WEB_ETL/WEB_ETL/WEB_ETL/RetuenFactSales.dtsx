                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">-- استفاده از GTIN معتبر برای پر کردن Nullها
SELECT 
1 as type,
s.ShomarehFaktor,
     s.Date Factordate,
    s.ReturnQuantity,
    s.Returnprice  ,
     0 IsPrize,
    dc.Id as centerid,
    s.Gln,
    p.kharazmi productcode -- پر کردن NULLها
	,N'mahya' as pakhsh, 47000 as  [valuepakhsh]
		,sku.id batchid

    --s.ProductId
	--select *
FROM web.Mahya_CustomerSales s
JOIN dw.kharazmi.DimCenterPakhsh dc ON dc.mahya = s.CenterCode
join (select * from web.mapproduct) p on p.mahya= s.ProductCode
 join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= ''

WHERE s.NoeBarge = N'مرجوعي فاکتور'
and IsInsert=1 
--and ShomarehFaktor= 14030019
union all
SELECT 
1 as type,
s.ShomarehFaktor,
     Date Factordate,
    abs(ReturnBonus) as ReturnQuantity ,
     convert (decimal (18,2) ,0) as Returnprice  ,
      1   IsPrize,
    dc.Id as centerid,
    s.Gln,
    p.kharazmi productcode -- پر کردن NULLها
	,N'mahya' as pakhsh, 47000 as  [valuepakhsh]
	,sku.id batchid
    --s.ProductId
	--select *
FROM web.Mahya_CustomerSales s
JOIN dw.kharazmi.DimCenterPakhsh dc ON dc.mahya = s.CenterCode
join (select * from web.mapproduct) p on p.mahya= s.ProductCode
 join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= ''
WHERE s.NoeBarge = N'مرجوعي فاکتور'
and ReturnBonus&lt;&gt;0
and IsInsert=1</property>
