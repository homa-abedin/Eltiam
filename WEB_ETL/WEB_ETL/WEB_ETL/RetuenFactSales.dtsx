                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">delete FROM web.samen_CustomerSales  
where ProductName is null


SELECT 
1 as type,
    s.date,
    abs(s.Quantity)Quantity,
    abs(Quantity)*  cast (abs(SellPrice) as decimal(18,2) )as price ,
    0  IsPrize,
      sku.id batchID,
    dc.Id as centerid,
    s.Customer_GLN,
	 --d.Date ExpireDate,
    p.kharazmi  productcode-- پر کردن NULLها
	,N'Samen' as pakhsh, 52000 as  [valuepakhsh]
    --s.ProductId
	--select * 
FROM web.samen_CustomerSales s
JOIN (select * from  dw.kharazmi.DimCenterPakhsh) dc ON dc.samen = s.CenterCode
 join (select distinct kharazmi, samen from web.mapproduct) p on p.samen= s.ProductCode
 join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= s.BatchNo
--join (select * from dimdate)d on REPLACE(Gregorian, '/','')=REPLACE( s.ExpireDate,'-' , '')+'01'
WHERE
Quantity&lt;0 and 
 IsInsert=1</property>
