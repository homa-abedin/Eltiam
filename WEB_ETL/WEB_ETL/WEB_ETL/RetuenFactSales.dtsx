                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select 
    1 type,
    0 isprize,
    null invoiceNo,
    s.[Date] invoiceDate,
    c.Id centerid,
    p.kharazmi productcode,
    --s.ProductCode ProductCodeOrig,
    null GLN,
    s.QtyReturnWOPrize Quantity,
    cast (ds.Id as bigint) batchID,
    cast(s.ReturnAmountWOPrize  as decimal(18,0)) Price,
    N'behe' pakhsh,
	69257 as valuepakhsh
	--select *
from stage.Web.behestan s
left join web.mapproduct p 
    on p.behestan = s.ProductCode
left join dw.kharazmi.DimCenterPakhsh c 
    on c.behestan = s.centercode
left join (select * from dw.kharazmi.dimsku)ds on ds.BatchNo= s.Batch and p.kharazmi= ds.ProductCode
where 
    s.isinsert = 1
    and s.returnpackages &lt;&gt; 0


union all
select 
    1 type,
    1 isprize,
    null invoiceNo,
    s.[Date] invoiceDate,
    c.Id centerid,
    p.kharazmi productcode,
    --s.ProductCode ProductCodeOrig,
    null GLN,
    s.returnbonuspackages Quantity,
    cast (ds.Id as bigint) batchID,
    abs(cast(s.ReturnAmountPrize  as decimal(18,0))) Price,
    N'behe' pakhsh,
	69257 as valuepakhsh
	--select *
from stage.Web.behestan s
left join web.mapproduct p 
    on p.behestan = s.ProductCode
left join dw.kharazmi.DimCenterPakhsh c 
    on c.behestan = s.centercode
left join (select * from dw.kharazmi.dimsku)ds on ds.BatchNo= s.Batch and p.kharazmi= ds.ProductCode
where 
    s.isinsert = 1
    and s.ReturnAmountPrize &lt;&gt; 0</property>
