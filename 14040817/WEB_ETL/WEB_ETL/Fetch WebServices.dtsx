    }

    public override void CreateNewOutputRows()
    {
        bool fireAgain = false;

        /*
          Add rows by calling the AddRow method on the member variable named "<Output Name>Buffer".
          For example, call MyOutputBuffer.AddRow() if your output was named "MyOutput".
        */
        try
        {
            object rawConnection = Connections.StageDimdate.AcquireConnection(null);
            var conn = (SqlConnection)rawConnection;
            var dates = new List<int>();
            string query = "SELECT Fdatekey FROM [kharazmi].[FetchWebservice] where ( barij is null or (barij & 2)=0)  and miladidate <= FORMAT( dateadd(day,-1,getdate()), 'yyyy-MM-dd')  ";

            using (SqlCommand cmd = new SqlCommand(query, conn))
            using (SqlDataReader reader = cmd.ExecuteReader())
                while (reader.Read())
                {
                    dates.Add(reader.GetInt32(0));
                }

            Connections.StageDimdate.ReleaseConnection(rawConnection);

            foreach (var id in dates) 
            {
                ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12;
               
                string url = $"http://91.92.186.30:7070/api/TaminKonandeh/GetForoshFaktorTaminKonandeh?"+
                    $"AzTarikh={id }&TaTarikh={id }&MarkazId=0&UserName=kharazmi&Password=123456";


                HttpWebRequest request = (HttpWebRequest)WebRequest.Create(url);
                request.Method = "GET";
                request.ContentType = "application/json";
                HttpWebResponse response = (HttpWebResponse)request.GetResponse();

                using (StreamReader reader = new StreamReader(response.GetResponseStream()))
                {
                    string json = reader.ReadToEnd();

                    var serializer = new JavaScriptSerializer();
                    var list = serializer.Deserialize<List<ForoshMarjoeeMoshtarianKalaInfo>>(json);

                    foreach (var item in list)
                    {
                        Output0Buffer.AddRow();
                        Output0Buffer.Distributor = "Barij";
                        Output0Buffer.DistributorCode = 73;
                        Output0Buffer.Center = item.NameMarkazPakhsh;
                        Output0Buffer.CenterCode = item.ccMarkazPakhsh;
                        Output0Buffer.Product = item.NameKala;
                        Output0Buffer.ProductCode = item.CodeKalaOld;
                        Output0Buffer.CustomerCode = item.CodeMoshtaryOld;
                        Output0Buffer.Customer = item.NameMoshtary;
                        Output0Buffer.GLN =Convert.ToInt64( item.GlnMoshtary);
                        Output0Buffer.Address = item.Address;
                        Output0Buffer.ShomarehFaktor = item.ShomarehFaktor;
                        Output0Buffer.Quantity = (int) item.TedadForosh;
                        Output0Buffer.Price = item.GheymatForosh;
                        Output0Buffer.NetPrice = item.MablaghForoshNakhales;
                        Output0Buffer.Bonus = (int)item.TedadJayezeh;
                        Output0Buffer.ReturnQuantity = (int)item.MarjoeeTedadi;
                        Output0Buffer.ReturnPrice = item.MarjoeeRilai;
                        Output0Buffer.Date =Convert.ToInt32( item.TarikhFaktor);
                        Output0Buffer.IsInsert = 1;
                    }
                }

                response.Close();
                try
                {

                    string connStr = "Data Source=192.168.10.10;Initial Catalog=stage;Integrated Security=SSPI;";
                    using (SqlConnection connUpdate = new SqlConnection(connStr))
                    {
                        connUpdate.Open();
                        string queryupdate = @"UPDATE d SET barij =( isnull(barij,0) | 2) FROM [kharazmi].[FetchWebservice] d WHERE FDatekey = @FDatekey";


                        object rawConnection2 = Connections.StageDimdate.AcquireConnection(null);
                        var conn2 = (SqlConnection)rawConnection2;

                        using (SqlCommand cmd2 = new SqlCommand(queryupdate, conn2))
                        {
                            cmd2.Parameters.AddWithValue("@FDatekey", id);
                            int rowsAffected = cmd2.ExecuteNonQuery();
                            ComponentMetaData.FireInformation(0, "CustomLog", $"Updated ID {id}, rows affected: {rowsAffected}", "", 0, ref fireAgain);
                        }
                    }
                }
                catch (Exception ex)
                {
                    this.ComponentMetaData.FireInformation(0, "CustomLog", $"exception: {ex.Message}", "", 0, ref fireAgain);

                }

            }


        }
        catch (Exception ex)
        {
            ComponentMetaData.FireError(0, "Error in API Call", ex.Message, "", 0, out fireAgain);
        }
    }

}
]]></arrayElement>
