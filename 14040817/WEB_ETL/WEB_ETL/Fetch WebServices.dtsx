                        <arrayElement
                          dataType="System.String"><![CDATA[using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace SC_bfedbef221d8482bbaac0c9686612bb4
{
    public class ForoshMarjoeeMoshtarianKalaInfo
    {
        public string Address { get; set; }
        public int CodeForoshandeh { get; set; }
        public int CodeKala { get; set; }
        public int CodeMoshtary { get; set; }
        public int CodeTaminKonandeh { get; set; }
        public string GLN { get; set; }
        public string HIX { get; set; }
        public long MablaghForosh { get; set; }
        public long MablaghForoshKhales { get; set; }
        public long MablaghMarjooe { get; set; }
        public long MablaghUnitPrice { get; set; }
        public string NameForoshandeh { get; set; }
        public string NameKala { get; set; }
        public string NameMantagheh { get; set; }
        public string NameMarkazPakhsh { get; set; }
