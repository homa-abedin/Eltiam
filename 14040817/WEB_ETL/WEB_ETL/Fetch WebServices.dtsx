                        <arrayElement
                          dataType="System.String"><![CDATA[#region Namespaces
using System;
using System.Collections.Generic;
using System.Net.Http;
using System.Text;
using System.Web.Script.Serialization;
using System.Threading;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
#endregion

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    // HttpClient استاتیک برای reuse و جلوگیری از مشکلات connection pool
    private static readonly HttpClient client = new HttpClient();

    // SemaphoreSlim برای محدود کردن اجرای همزمان
    private static readonly SemaphoreSlim semaphore = new SemaphoreSlim(1, 1);

    public override void CreateNewOutputRows()
    {
        bool fireAgain = false;

        // قفل async را همزمان در اینجا sync اجرا می کنیم با Wait
        semaphore.Wait();
        try
        {
            string url = "http://188.75.73.76/suppliers_api/GetCenters?PageSize=100";
            string urltoken = "http://188.75.73.76/suppliers_api/Authentication/GetToken";
            var serializer = new JavaScriptSerializer();

            // گرفتن توکن
            client.DefaultRequestHeaders.Clear();
            client.DefaultRequestHeaders.Add("accept", "*/*");

            var contenttoken = new StringContent(
                serializer.Serialize(new { userName = "kharazmi", password = "Kg18725" }),
                Encoding.UTF8,
                "application/json");

            var responsetoken = client.PostAsync(urltoken, contenttoken).GetAwaiter().GetResult();
            if (!responsetoken.IsSuccessStatusCode)
                throw new Exception($"Token request failed: {responsetoken.StatusCode}");

            var tokenRaw = responsetoken.Content.ReadAsStringAsync().GetAwaiter().GetResult();
            string token = tokenRaw.Trim('"');

            // درخواست داده‌ها با توکن دریافت شده
            client.DefaultRequestHeaders.Clear();
            client.DefaultRequestHeaders.Add("accept", "application/json");
            client.DefaultRequestHeaders.Add("Authorization", $"Bearer {token}");

            var response = client.GetAsync(url).GetAwaiter().GetResult();
            if (!response.IsSuccessStatusCode)
                throw new Exception($"GetCenters API failed: {response.StatusCode}");

            string json = response.Content.ReadAsStringAsync().GetAwaiter().GetResult();
            var list = serializer.Deserialize<Root2>(json);

            if (list == null)
                throw new Exception("Deserialized list is null.");
            if (list.data == null)
                throw new Exception("Data list is null.");

            foreach (var item in list.data)
            {
                Output0Buffer.AddRow();
                Output0Buffer.CenterKey = item.centerKey ?? 0;
                Output0Buffer.center = item.center;
                Output0Buffer.cityKey = item.cityKey ?? 0;
                // اگر نیاز داری این خط را فعال کن
                // Output0Buffer.company = item.company;
            }
        }
        catch (Exception ex)
        {
            ComponentMetaData.FireError(0, "Error in API Call",
                $"Message: {ex.Message} | Stack: {ex.StackTrace} | Inner: {ex.InnerException?.Message}",
                "", 0, out fireAgain);
        }
        finally
        {
            semaphore.Release();
        }
    }

    public class Root2
    {
        public int currentPage { get; set; }
        public int pageCount { get; set; }
        public int pageSize { get; set; }
        public int rowCount { get; set; }
        public List<Datum> data { get; set; }
        public class Datum
        {
            public int? centerKey { get; set; }
            public string center { get; set; }
            public int? cityKey { get; set; }
            // public string company { get; set; } // اگر نیاز داری
        }
    }
}
]]></arrayElement>
