    public override void CreateNewOutputRows()
    {
        bool fireAgain = false;
        /*
          Add rows by calling the AddRow method on the member variable named "<Output Name>Buffer".
          For example, call MyOutputBuffer.AddRow() if your output was named "MyOutput".
        */
        try
        {
            object rawConnection = Connections.StageDimdate.AcquireConnection(null);
            var conn = (SqlConnection)rawConnection;
            var dates = new List<(string fdate, string ldate)>();
            string query = "SELECT fjalali, ljalai FROM [kharazmi].[FetchWebservice] where ( hasti is null or (hasti & 2)=0)  and miladidate <= FORMAT( dateadd(day,-1,getdate()), 'yyyy-MM-dd')  ";

            using (SqlCommand cmd = new SqlCommand(query, conn))
            using (SqlDataReader reader = cmd.ExecuteReader())
                while (reader.Read())
                {
                    dates.Add((reader.GetString(0), reader.GetString(1)));

                }

            Connections.StageDimdate.ReleaseConnection(rawConnection);

            foreach (var  date in dates)
            {
                string url = "http://sphreports.salamatpakhsh.com:25684/ReportService.svc/json/Get_sp_AllData";
                using (var client = new HttpClient(new HttpClientHandler()
                {
                    UseProxy = false,
                    AutomaticDecompression = DecompressionMethods.GZip | DecompressionMethods.Deflate

                })
                {
                    Timeout = TimeSpan.FromSeconds(30)
                })
                {


                    client.DefaultRequestHeaders.Add("accept", "application/json");

                        var serializer = new JavaScriptSerializer();
                        serializer.MaxJsonLength = Int32.MaxValue;
                    //var x = PersianToGregorian(id);
                    //var nextday= x.Value.AddDays(1);
                    //var nextdayjalali = GregorianToPersianFormat(nextday, "yyyy/MM/dd");

                    var d = serializer.Serialize(new
                    {
                        Token = "24852246",
                        UserName = "KHA111",
                        Password = "sph!@#1431",
                        TypeID = 16,
                        FromDate = date.fdate,
                        ToDate = date.ldate

                    });
                    var content = new StringContent(d, null, "application/json");
                    var response = client.PostAsync(url, content).GetAwaiter().GetResult();
                    string json = response.Content.ReadAsStringAsync().GetAwaiter().GetResult();
                    ComponentMetaData.FireInformation(0, "CustomLog", $"Updated ID {date.fdate}, rows affected: {json}", "", 0, ref fireAgain);
                    //https://json2csharp.com/
                    var list = serializer.Deserialize<Root1>(json);
                    foreach (var item in list._Report_03)
                        {
                            Output0Buffer.AddRow();
                            Output0Buffer.BatchNo = item.BatchNo;
                        if (item != null && !string.IsNullOrWhiteSpace(item.CustGLN))
                        {
                            Output0Buffer.CustGLN = Convert.ToInt64(item.CustGLN);
                        }
                            Output0Buffer.CustID =Convert.ToString(item.CustID);
                            Output0Buffer.CustName = item.CustName;
                            Output0Buffer.DSID = Convert.ToString(item.DSID);
                            Output0Buffer.DSName = item.DSName;
                            Output0Buffer.ProdID = Convert.ToString(item.ProdID);
                            Output0Buffer.ProdName = item.ProdName ;
                            Output0Buffer.ProdPrice = item.ProdPrice??0;
                            Output0Buffer.ProdPriceKhales = item.ProdPriceKhales ??0;
                            Output0Buffer.ProdPriceSum = item.ProdPriceSum ?? 0;
                            Output0Buffer.ProdQty = item.ProdQty ?? 0;
                            Output0Buffer.ProdQtyKhales = item.ProdQtyKhales ?? 0;
                            Output0Buffer.ProdQtyRet = item.ProdQtyRet ?? 0;
                            Output0Buffer.ProdSumDis = item.ProdSumDis ?? 0;
                            Output0Buffer.ProdSumDisRet = item.ProdSumDisRet ?? 0;
                            Output0Buffer.SalesDate =Convert.ToInt32( item.SalesDate.Replace("/", ""));
                            Output0Buffer.SalesID = Convert.ToInt64(item.SalesID ?? 0) ;
                            Output0Buffer.TypeSales = item.TypeSales ;
                            Output0Buffer.isinsert = 1;
                    }
                }
                try
                {
                    string connStr = "Data Source=192.168.10.10;Initial Catalog=stage;Integrated Security=SSPI;";
                    using (SqlConnection connUpdate = new SqlConnection(connStr))
                    {
                        connUpdate.Open();
                        string queryupdate = @"UPDATE d SET hasti =( isnull(hasti,0) | 2) FROM [kharazmi].[FetchWebservice] d WHERE Fjalali= @Fjalali";


                        object rawConnection2 = Connections.StageDimdate.AcquireConnection(null);
                        var conn2 = (SqlConnection)rawConnection2;

                        using (SqlCommand cmd2 = new SqlCommand(queryupdate, conn2))
                        {
                            cmd2.Parameters.AddWithValue("@Fjalali", date.fdate);
                            int rowsAffected = cmd2.ExecuteNonQuery();
                            ComponentMetaData.FireInformation(0, "CustomLog", $"Updated ID {date.fdate}, rows affected: {rowsAffected}", "", 0, ref fireAgain);
                        }
                    }
                }
                catch (Exception ex)
                {
                    this.ComponentMetaData.FireInformation(0, "CustomLog", $"exception: {ex.Message}", "", 0, ref fireAgain);

                }

            }

        }
        catch (Exception ex)
        {

            ComponentMetaData.FireError(0, "Error in API Call", ex.Message, "", 0, out fireAgain);
        }
    }

