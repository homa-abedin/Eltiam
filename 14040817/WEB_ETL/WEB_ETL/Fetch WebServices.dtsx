        public decimal? DarRahQty { get; set; }
        public decimal? NotDistributedQty { get; set; }
        public int? totCostCenterID { get; set; }
        public string totCostCenterName { get; set; }
        public string invProductID { get; set; }
        public string invProdctName { get; set; }
        public decimal? StockAmnt { get; set; }
        public decimal? ZayeatQty { get; set; }
        public decimal ReservedQty { get; set; }
        //public string ReservedQty { get; set; }
        //public string ReservedQty { get; set; }
    }

