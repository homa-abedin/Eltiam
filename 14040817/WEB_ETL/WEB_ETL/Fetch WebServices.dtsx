    public override void CreateNewOutputRows()
    {
        bool fireAgain = false;
        /*
          Add rows by calling the AddRow method on the member variable named "<Output Name>Buffer".
          For example, call MyOutputBuffer.AddRow() if your output was named "MyOutput".
        */
        try
        {
            object rawConnection = Connections.StageDimdate.AcquireConnection(null);
            var conn = (SqlConnection)rawConnection;
            var datePairs = new List<(string MiladiDate, int fdatekey )>();
            string query = "SELECT MiladiDate, fdatekey FROM [kharazmi].[FetchWebservice] where ( Samen is null or (Samen & 1)=0)  and miladidate <= FORMAT( dateadd(day,-1,getdate()), 'yyyy-MM-dd')  ";

            using (SqlCommand cmd = new SqlCommand(query, conn))
            using (SqlDataReader reader = cmd.ExecuteReader())
                while (reader.Read())
                {
                    datePairs.Add((reader.GetString(0), reader.GetInt32(1)));
                }

            Connections.StageDimdate.ReleaseConnection(rawConnection);



            foreach (var pair in datePairs)
            {
                string miladiDate = pair.MiladiDate;
                int fdatekey = pair.fdatekey;
                string url = "http://webservice.yts.ir:8060/ErpSuppliersClubService.svc/customerbatchsalesSAservice";


                using (var client = new HttpClient())
                {

                    //var byteArray = System.Text.Encoding.ASCII.GetBytes("kharazmi:Ki3256");
                    //client.DefaultRequestHeaders.Authorization =
                    //new System.Net.Http.Headers.AuthenticationHeaderValue("Basic", Convert.ToBase64String(byteArray));
                    client.DefaultRequestHeaders.Add("accept", "application/json");
                    var serializer = new JavaScriptSerializer();
                    var content = new StringContent(
                    serializer.Serialize(new
                    {
                        AuthenticateInfo = new
                        {
                            UserName = "Kharazmi",
                            Password = "123456789K",
                        },

                        FromDate = miladiDate,
                        EndDate = miladiDate

                    }), System.Text.Encoding.UTF8, "application/json");
                    var response = client.PostAsync(url, content).GetAwaiter().GetResult();
                    string json = response.Content.ReadAsStringAsync().GetAwaiter().GetResult();
                    //this.ComponentMetaData.FireInformation(0, "CustomLog", $"json: {json}", "", 0, ref fireAgain);
                    //https://json2csharp.com/
                    var list = serializer.Deserialize<Root1>(json);
                    foreach (var item in list.data)
                    {
                        Output0Buffer.AddRow();
                        Output0Buffer.BatchNo = item.BatchNo;
                        Output0Buffer.BuyPrice = item.BuyPrice;
                        Output0Buffer.CenterCode = item.CenterCode.ToString();
                        Output0Buffer.CenterName = item.CenterName;
                        Output0Buffer.CustomerName = item.CustomerName;
                        Output0Buffer.CustomerGLN = item.Customer_GLN;
                        Output0Buffer.ExpireDate = Convert.ToDateTime(item.ExpireDate);

                        Output0Buffer.ProductCode = item.ProductCode.ToString();
                        Output0Buffer.ProductName = item.ProductName;
                        Output0Buffer.Quanity = item.Quanity ?? 0;
                        Output0Buffer.SellPrice = item.SellPrice ?? 0;
                        Output0Buffer.TotalPurePrice = item.TotalPurePrice ?? 0;
                        Output0Buffer.date = fdatekey;
                        Output0Buffer.isinsert = 1;
                    }
                }
                try
                {
                    string connStr = "Data Source=192.168.10.10;Initial Catalog=stage;Integrated Security=SSPI;";
                    using (SqlConnection connUpdate = new SqlConnection(connStr))
                    {
                        connUpdate.Open();
                        string queryupdate = @"UPDATE d SET Samen =( isnull(Samen,0) | 1) FROM [kharazmi].[FetchWebservice] d WHERE miladidate = @miladiDate";


                        object rawConnection2 = Connections.StageDimdate.AcquireConnection(null);
                        var conn2 = (SqlConnection)rawConnection2;

                        using (SqlCommand cmd2 = new SqlCommand(queryupdate, conn2))
                        {
                            cmd2.Parameters.AddWithValue("@miladiDate", miladiDate);
                            int rowsAffected = cmd2.ExecuteNonQuery();
                            ComponentMetaData.FireInformation(0, "CustomLog", $"Updated ID {fdatekey}, rows affected: {rowsAffected}", "", 0, ref fireAgain);
                        }
                    }

                }
                catch (Exception ex)
                {
                    this.ComponentMetaData.FireInformation(0, "CustomLog", $"exception: {ex.Message}", "", 0, ref fireAgain);

                }
            }

        }
        catch (Exception ex)
        {

            ComponentMetaData.FireError(0, "Error in API Call", ex.Message, "", 0, out fireAgain);
        }
    }





    public class Result
    {
        public string BatchNo { get; set; }
        public int BuyPrice { get; set; }
        public int CenterCode { get; set; }
        public string CenterName { get; set; }
        public string CustomerName { get; set; }
        public string Customer_GLN { get; set; }
        public string ExpireDate { get; set; }
        public int ProductCode { get; set; }
        public string ProductName { get; set; }
        public int ? Quanity { get; set; }
        public int? SellPrice { get; set; }
        public decimal? TotalPurePrice { get; set; }
        

    }

    public class Root1
    {
        
        public List<Result> data { get; set; }
        
    }
}]]></arrayElement>
