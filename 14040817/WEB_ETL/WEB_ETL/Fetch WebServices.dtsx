    public override void CreateNewOutputRows()
    {
        bool fireAgain = false;

        /*
          Add rows by calling the AddRow method on the member variable named "<Output Name>Buffer".
          For example, call MyOutputBuffer.AddRow() if your output was named "MyOutput".
        */
        try
        {
            object rawConnection = Connections.StageDimdate.AcquireConnection(null);
            var conn = (SqlConnection)rawConnection;
            var dates = new List<int>();
            string query = "SELECT Fdatekey FROM [kharazmi].[FetchWebservice] where ( qasem is null or (qasem & 1)=0)  and miladidate <= FORMAT( dateadd(day,-1,getdate()), 'yyyy-MM-dd')  ";

            using (SqlCommand cmd = new SqlCommand(query, conn))
            using (SqlDataReader reader = cmd.ExecuteReader())
                while (reader.Read())
                {
                    dates.Add(reader.GetInt32(0));
                }

            Connections.StageDimdate.ReleaseConnection(rawConnection);

            foreach (var id in dates)

            {
                string url = "https://ghasemservice.minoogroup.com/GhasemService.asmx";
                string soapAction = "http://tempuri.org/GetSalesReport";
                string xml = $@"<?xml version=""1.0"" encoding=""utf-8""?>
<soap:Envelope xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance""
               xmlns:xsd=""http://www.w3.org/2001/XMLSchema""
               xmlns:soap=""http://schemas.xmlsoap.org/soap/envelope/"">
  <soap:Body>
    <GetSalesReport xmlns=""http://tempuri.org/"">
      <UserName>kharazmipharm</UserName>
      <Password>Km724257</Password>
      <FromDate>{id}</FromDate>
      <ToDate>{id}</ToDate>
      <TimeStamp></TimeStamp>
    </GetSalesReport>
  </soap:Body>
</soap:Envelope>";

                using (var client = new HttpClient() { Timeout = TimeSpan.FromSeconds(120) })
                {
                    var content = new StringContent(xml, Encoding.UTF8, "text/xml");
                    content.Headers.Add("SOAPAction", soapAction);

                    var response = client.PostAsync(url, content).GetAwaiter().GetResult();
                    string result = response.Content.ReadAsStringAsync().GetAwaiter().GetResult();
                 //this.ComponentMetaData.FireInformation(0, "CustomLog", $"aaaaaaaaaaaaaaaa: {result}", "", 0, ref fireAgain);
                    XmlDocument doc = new XmlDocument();
                   doc.LoadXml(result);

                    XmlNamespaceManager nsmgr = new XmlNamespaceManager(doc.NameTable);
                    nsmgr.AddNamespace("diffgr", "urn:schemas-microsoft-com:xml-diffgram-v1");
                    nsmgr.AddNamespace("msdata", "urn:schemas-microsoft-com:xml-msdata");
                    nsmgr.AddNamespace("soap", "http://schemas.xmlsoap.org/soap/envelope/");
                    nsmgr.AddNamespace("tem", "http://tempuri.org/");

                    XmlNodeList tableNodes = doc.SelectNodes("//diffgr:diffgram/NewDataSet/Table", nsmgr);

                    foreach (XmlNode table in tableNodes)
                    {

                        Output0Buffer.AddRow();
                        //Output0Buffer.Distributor = "Qhasem";
                        //Output0Buffer.DistributorCode = 29000;
                        Output0Buffer.UniqueID = table["UniqueID"]?.InnerText;
                        Output0Buffer.FactorID = table["FactorID"]?.InnerText;
                        if (int.TryParse(table["FactorDate"]?.InnerText, out int factorDate))
                            Output0Buffer.FactorDate = factorDate;

                        if (decimal.TryParse(table["Quantity"]?.InnerText, out decimal qty))
                            Output0Buffer.Quantity =Convert.ToInt32(Math.Round( qty));


                        if (decimal.TryParse(table["Price"]?.InnerText, out decimal price))
                            Output0Buffer.Price = price;

                        if (int.TryParse(table["RecordTypeID"]?.InnerText, out int recordTypeId))
                            Output0Buffer.RecordTypeID = recordTypeId;
                        Output0Buffer.RecordType = table["RecordType"]?.InnerText;

                        
                        Output0Buffer.IsPrize = table["IsPrize"].InnerText.Trim().ToLower() == "true" ? (int)1 : (int)0;

                        Output0Buffer.BatchNumber = table["BatchNumber"]?.InnerText;
                        Output0Buffer.ExpireDate = table["ExpireDate"]?.InnerText;
                        Output0Buffer.Center = table["CenterName"]?.InnerText;
                        Output0Buffer.CenterCode = table["CenterID"]?.InnerText;
                        Output0Buffer.Customer = table["CustomerName"]?.InnerText;
                        Output0Buffer.CustomerCode = table["CustomerID"]?.InnerText;
                        Output0Buffer.CustomerType = table["CustomerType"]?.InnerText;
                        Output0Buffer.Product = table["ProductName"]?.InnerText;
                        Output0Buffer.ProductCode =table["ProductID"]?.InnerText;
                        var glnNode = table["GLN"];
                        if (glnNode != null && !string.IsNullOrWhiteSpace(glnNode.InnerText) && long.TryParse(glnNode.InnerText, out long gln))
                            Output0Buffer.GLN = gln;

                        var gtinNode = table["GTIN"];
                        if (gtinNode != null && !string.IsNullOrWhiteSpace(gtinNode.InnerText) && long.TryParse(gtinNode.InnerText, out long gtin))
                            Output0Buffer.GTIN = gtin;


                        //Output0Buffer.GTIN =Convert.ToInt64( table["GTIN"]?.InnerText);
                        Output0Buffer.IsInsert = 1;
                    }

                }
                try
                {
                    string connStr = "Data Source=192.168.10.10;Initial Catalog=stage;Integrated Security=SSPI;";
                    using (SqlConnection connUpdate = new SqlConnection(connStr))
                    {
                        connUpdate.Open();

                        string queryupdate = @"UPDATE d SET qasem =( isnull(qasem,0) | 1) FROM [kharazmi].[FetchWebservice] d WHERE FDatekey = @FDatekey";


                        object rawConnection2 = Connections.StageDimdate.AcquireConnection(null);
                        var conn2 = (SqlConnection)rawConnection2;

                        using (SqlCommand cmd2 = new SqlCommand(queryupdate, conn2))
                        {
                            cmd2.Parameters.AddWithValue("@FDatekey", id);
                            int rowsAffected = cmd2.ExecuteNonQuery();
