         */
    }

    public override void CreateNewOutputRows()
    {
        bool fireAgain = false;

        /*
          Add rows by calling the AddRow method on the member variable named "<Output Name>Buffer".
          For example, call MyOutputBuffer.AddRow() if your output was named "MyOutput".
        */
        try
        {
            object rawConnection = Connections.StageDimdate.AcquireConnection(null);
            var conn = (SqlConnection)rawConnection;
            var dates = new List<int>();
            string query = "SELECT Fdatekey FROM [kharazmi].[FetchWebservice] where fdatekey  >= 14040101 and ( momtaz is null or (momtaz & 2)=0)  and miladidate <= FORMAT( dateadd(day,-1,getdate()), 'yyyy-MM-dd')  ";

            using (SqlCommand cmd = new SqlCommand(query, conn))
            using (SqlDataReader reader = cmd.ExecuteReader())
                while (reader.Read())
                {
                    dates.Add(reader.GetInt32(0));
                }

            Connections.StageDimdate.ReleaseConnection(rawConnection);

            foreach (int id in dates)
            {
                string url = $"http://188.75.73.76/suppliers_api/GetSales?Filter.FromDateKey={id}&Filter.ToDateKey={id}";
                string urltoken = "http://188.75.73.76/suppliers_api/Authentication/GetToken";
                using (var client = new HttpClient())
                {
                    using (var clienttoken = new HttpClient())
                    {
                        clienttoken.DefaultRequestHeaders.Add("accept", "*/*");
                        var serializer = new JavaScriptSerializer();
                        var contenttoken = new StringContent(
                            serializer.Serialize(new
                            {
                                userName = "kharazmi",
                                password = "Kg18725",
                            }), null, "application/json");
                        var responsetoken = clienttoken.PostAsync(urltoken, contenttoken).GetAwaiter().GetResult();

                        if (responsetoken.IsSuccessStatusCode)
                        {
                            var token = responsetoken.Content.ReadAsStringAsync().GetAwaiter().GetResult();

                            client.DefaultRequestHeaders.Add("accept", "application/json");
                            client.DefaultRequestHeaders.Add("Authorization", $"Bearer {token}");

                            var pagetotal = 1;
                            var i = 1;
                            do
                            {
                                var uriBuilder = new UriBuilder(url);
                                var query1 = HttpUtility.ParseQueryString(uriBuilder.Query);
                                query1["PageNum"] = i.ToString();
                                query1["PageSize"] = "1000";
                                uriBuilder.Query = query1.ToString();


                                var response = client.GetAsync(uriBuilder.ToString()).GetAwaiter().GetResult();
                                string json = response.Content.ReadAsStringAsync().GetAwaiter().GetResult();

                                //https://json2csharp.com/
                                var list = serializer.Deserialize<Root2>(json);
                            ComponentMetaData.FireInformation(0, "PageInfo", $"DateKey {id}: Total Pages = {list.pageCount}", "", 0, ref fireAgain);

                                foreach (var item in list.data)
                                {
                                    Output0Buffer.AddRow();
                                    Output0Buffer.productKey = item.productKey;
                                    Output0Buffer.skuKey = item.skuKey;
                                    Output0Buffer.datekey = item.datekey;
                                    Output0Buffer.centerKey = item.centerKey;
                                    Output0Buffer.customerKey = item.customerKey;
                                    Output0Buffer.invoiceNumber = item.invoiceNumber;
                                    Output0Buffer.quantity = item.quantity;
                                    Output0Buffer.cost = item.cost;
                                    Output0Buffer.price = item.price;
                                    Output0Buffer.consumerPrice = item.consumerPrice;
                                    Output0Buffer.headerId = item.headerId;
                                    Output0Buffer.isinsert =1;

                                }
                                pagetotal = (list.pageCount );
                                i++;
                            } while (i <= pagetotal);


                        }

                    }
                }

                try
                {
                    string connStr = "Data Source=192.168.10.10;Initial Catalog=stage;Integrated Security=SSPI;";
                    using (SqlConnection connUpdate = new SqlConnection(connStr))
                    {
                        connUpdate.Open();

                        string queryupdate = @"UPDATE d SET momtaz =( isnull(momtaz,0) | 2) FROM [kharazmi].[FetchWebservice] d WHERE FDatekey = @FDatekey";


                        object rawConnection2 = Connections.StageDimdate.AcquireConnection(null);
                        var conn2 = (SqlConnection)rawConnection2;

                        using (SqlCommand cmd2 = new SqlCommand(queryupdate, conn2))
                        {
                            cmd2.Parameters.AddWithValue("@FDatekey", id);
                            int rowsAffected = cmd2.ExecuteNonQuery();
                            ComponentMetaData.FireInformation(0, "CustomLog", $"Updated ID {id}, rows affected: {rowsAffected}", "", 0, ref fireAgain);
                        }
                    }
                }
                catch (Exception ex)
                {
                    this.ComponentMetaData.FireInformation(0, "CustomLog", $"exception: {ex.Message}", "", 0, ref fireAgain);

                }
            }

        }
        catch (Exception ex)
        {
    ComponentMetaData.FireError(0, "Error in API Call", ex.Message, "", 0, out fireAgain);
        }
    }
    public class Root2
    {
        public int currentPage { get; set; }
        public int pageCount { get; set; }
        public int pageSize { get; set; }
        public int rowCount { get; set; }
        public List<Datum> data { get; set; }
        public class Datum
        {
            public int productKey { get; set; }
            public int skuKey { get; set; }
            public int datekey { get; set; }
            public int centerKey { get; set; }
            public int customerKey { get; set; }
            public int invoiceNumber { get; set; }
            public int quantity { get; set; }
            public decimal cost { get; set; }
            public decimal price { get; set; }
            public decimal consumerPrice { get; set; }
            public int headerId { get; set; }

        }
    }

}]]></arrayElement>
