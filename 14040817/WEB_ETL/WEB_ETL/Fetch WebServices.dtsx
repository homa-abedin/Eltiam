    public override void CreateNewOutputRows()
    {
        bool fireAgain = false;

        try
        {
            // Connection برای SELECT
            object rawConnection = Connections.StageDimdate.AcquireConnection(null);
            var conn = (SqlConnection)rawConnection;

            var dates = new List<int>();
            string query = @"SELECT Fdatekey FROM [kharazmi].[FetchWebservice]
                         WHERE (mahya IS NULL OR (mahya & 4) = 0)
                         AND miladidate <= FORMAT(DATEADD(day, -1, GETDATE()), 'yyyy-MM-dd')";

            using (SqlCommand cmd = new SqlCommand(query, conn))
            using (SqlDataReader reader = cmd.ExecuteReader())
            {
                while (reader.Read())
                {
                    dates.Add(reader.GetInt32(0));
                }
            }

            Connections.StageDimdate.ReleaseConnection(rawConnection);

            ComponentMetaData.FireInformation(0, "CustomLog", $"Fetched {dates.Count} dates to process", "", 0, ref fireAgain);

            foreach (var id in dates)
            {
                try
                {
                    ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12;

                    string url = $"https://api.mahyadc.com/GetForoshMojodiKoliByKala/?" +
                                 $"Username=kharazmi&Password=kh12345&FirstDate={id}&EndDate={id}";

                    var request = (HttpWebRequest)WebRequest.Create(url);
                    request.Method = "GET";
                    request.ContentType = "application/json";

                    using (var response = (HttpWebResponse)request.GetResponse())
                    using (var readeri = new StreamReader(response.GetResponseStream()))
                    {
                        string json = readeri.ReadToEnd();

                        if (!string.IsNullOrWhiteSpace(json))
                        {
                            var serializer = new JavaScriptSerializer();
                            var list = serializer.Deserialize<List<ForoshMarjoeeMoshtarianKalaInfo>>(json);

                            ComponentMetaData.FireInformation(0, "CustomLog", $"API returned {json} ", "", 0, ref fireAgain);

                            foreach (var item in list)
                            {
                                Output0Buffer.AddRow();

                                Output0Buffer.Distributor = "Mahya Darou";
                                Output0Buffer.DistributorCode = 47000;

                                Output0Buffer.Product = item.NameKala;
                               Output0Buffer.ProductCode = item.CodeKala;

                                Output0Buffer.Quantity = item.ForoshTedadiKhales;
                                Output0Buffer.IRC = item.IRC;
                                if (!string.IsNullOrWhiteSpace(item.GTIN))
                                {
                                    Output0Buffer.GTIN = Convert.ToInt64(item.GTIN);
                                }
                                Output0Buffer.Price = item.GheymatForosh;
                                Output0Buffer.NetPrice = item.ForoshRialiKhalesForosh;

                                Output0Buffer.Bonus = item.EshantionTedadi;

                                Output0Buffer.Date = id;
                                Output0Buffer.IsInsert = 1;
                            }
                        }
                    }

                    // Connection جدا برای UPDATE
                    string connStr = "Data Source=192.168.10.10;Initial Catalog=stage;Integrated Security=SSPI;";
                    using (SqlConnection connUpdate = new SqlConnection(connStr))
                    {
                        connUpdate.Open();

                        string queryUpdate = @"UPDATE d SET mahya = (ISNULL(mahya, 0) | 4)
                                           FROM [kharazmi].[FetchWebservice] d
                                           WHERE FDatekey = @FDatekey";

                        using (SqlCommand cmdUpdate = new SqlCommand(queryUpdate, connUpdate))
                        {
                            cmdUpdate.Parameters.AddWithValue("@FDatekey", id);
                            int rows = cmdUpdate.ExecuteNonQuery();

                            ComponentMetaData.FireInformation(0, "CustomLog", $"Updated ID {id}, rows affected: {rows}", "", 0, ref fireAgain);
                        }
                    }
                }
                catch (Exception exInner)
                {
                    ComponentMetaData.FireError(0, "Error processing ID", $"ID {id}: {exInner.Message}", "", 0, out fireAgain);
                }
            }
        }
        catch (Exception ex)
        {
            ComponentMetaData.FireError(0, "General Error", ex.Message, "", 0, out fireAgain);
        }
    }
}
]]></arrayElement>
