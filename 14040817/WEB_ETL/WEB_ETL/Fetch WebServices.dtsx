    #endregion
    public override void PreExecute()
    {
        base.PreExecute();
    }
    public override void PostExecute()
    {
        base.PostExecute();
    }
    public override void CreateNewOutputRows()
    {
        bool fireAgain = false;
        try
        {
            object rawConnection = Connections.StageDimdate.AcquireConnection(null);
            var conn = (SqlConnection)rawConnection;
            var dates = new List<int>();
            string query = "SELECT Fdatekey FROM [kharazmi].[FetchWebservice] where fdatekey  < 14040101 and ( momtaz is null or (momtaz & 1)=0) and miladidate <= FORMAT( dateadd(day,-1,getdate()), 'yyyy-MM-dd')  ";

            using (SqlCommand cmd = new SqlCommand(query, conn))
            using (SqlDataReader reader = cmd.ExecuteReader())
                while (reader.Read())
                {
                    dates.Add(reader.GetInt32(0));
                }

            Connections.StageDimdate.ReleaseConnection(rawConnection);


            foreach (var id in dates)
            {
                string url = "http://188.75.73.78/SupplierService/SupplierFile.asmx";
                string soapAction = "http://p-momtaz.com/saleDocument_sply_prd_CostCenter_WithPrize";

                string xml = $@"<?xml version=""1.0"" encoding=""utf-8""?>
                <soap12:Envelope xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" xmlns:xsd=""http://www.w3.org/2001/XMLSchema"" xmlns:soap12=""http://www.w3.org/2003/05/soap-envelope"">
                  <soap12:Body>
                    <saleDocument_sply_prd_CostCenter_WithPrize xmlns=""http://p-momtaz.com/"">
                      <UserName>kharazmi</UserName>
                      <Password>Ki3256</Password>
                      <Fdate>14030205</Fdate>
                      <Tdate>14030205</Tdate>
                      <ErrorOut>string</ErrorOut>
                    </saleDocument_sply_prd_CostCenter_WithPrize>
                  </soap12:Body>
                </soap12:Envelope>";

                using (var client = new HttpClient() { Timeout = TimeSpan.FromSeconds(120) })
                {
                    var content = new StringContent(xml, Encoding.UTF8, "text/xml");
                    content.Headers.Add("SOAPAction", soapAction);

                    var response = client.PostAsync(url, content).GetAwaiter().GetResult();

                    if (!response.IsSuccessStatusCode)
                    {
                        continue;
                    }

                    string result = response.Content.ReadAsStringAsync().GetAwaiter().GetResult();
                    var fi = File.CreateText("E:\\NEW Dashboard\\LOG\\Newtext.txt");
                    fi.Write(result);
                    fi.Close();
                    this.ComponentMetaData.FireInformation(0, "CustomLog", $"result: {result}", "", 0, ref fireAgain);

                    XmlDocument doc = new XmlDocument();
                    doc.LoadXml(result);
                    this.ComponentMetaData.FireInformation(0, "CustomLog", $"result: {result}", "", 0, ref fireAgain);

                    XmlNamespaceManager nsmgr = new XmlNamespaceManager(doc.NameTable);
                    nsmgr.AddNamespace("soap", "http://schemas.xmlsoap.org/soap/envelope/");
                    nsmgr.AddNamespace("ns", "http://p-momtaz.com/");

                    XmlNodeList items = doc.SelectNodes("//ns:rptsaleDocument_sply_prd_CostCenter_WithPrize", nsmgr);
                    this.ComponentMetaData.FireInformation(0, "CustomLog", $"shode:  ", "", 0, ref fireAgain);

                    foreach (XmlNode item in items)
                    {
                        int tempInt;
                        int temDecimal;
                        Output0Buffer.AddRow();
                        Output0Buffer.Center = item["totCostCenterName"]?.InnerText;
                        Output0Buffer.CenterCode =Convert.ToInt32( item["totCostCenterCode"]?.InnerText);
                        Output0Buffer.Product = item["invProductName"]?.InnerText;
                        Output0Buffer.ProductCode = Convert.ToInt32(item["invProductCode"]?.InnerText);
                        Output0Buffer.Cost = Convert.ToDecimal(item["Cost"]?.InnerText);
                        Output0Buffer.Price = Convert.ToDecimal(item["Price"]?.InnerText);
                        //Output0Buffer.UserPrice = Convert.ToInt32(item["UserPrice"]?.InnerText);
                        Output0Buffer.StockQty = Convert.ToDecimal(item["StockQty"]?.InnerText);
                        Output0Buffer.StockAmnt = Convert.ToDecimal(item["StockAmnt"]?.InnerText);
                        Output0Buffer.NetAmountPrice = decimal.TryParse(item["NetAmountPrice"]?.InnerText, out var val0) ? val0 : 0;
                        Output0Buffer.QtyConfirmedInvoice = int.TryParse(item["QtyConfirmed_Invoice"]?.InnerText, out var val1) ? val1 : 0;
                        Output0Buffer.AmountPriceReturn = decimal.TryParse(item["AmountPrice_Return"]?.InnerText, out var val2) ? val2 : 0;
                        Output0Buffer.QtyConfirmedReturn = int.TryParse(item["QtyConfirmed_Return"]?.InnerText, out var val3) ? val3 : 0;
                        Output0Buffer.DarRahQty = int.TryParse(item["DarRahQty"]?.InnerText, out var val4) ? val4 : 0;
                        Output0Buffer.DarRahAmountCost = decimal.TryParse(item["DarRahAmountCost"]?.InnerText, out var val5) ? val5 : 0;
                        Output0Buffer.PurchaseQty = int.TryParse(item["PurchaseQty"]?.InnerText, out var val6) ? val6 : 0;
                        Output0Buffer.RespiteDays = int.TryParse(item["RespiteDays"]?.InnerText, out var val7) ? val7 : 0;
                        Output0Buffer.IsInsert = 1;
                        Output0Buffer.DateKey = id.ToString();


                    }
                }
                try
                {
                    string connStr = "Data Source=192.168.10.10;Initial Catalog=stage;Integrated Security=SSPI;";
                    using (SqlConnection connUpdate = new SqlConnection(connStr))
                    {
                        connUpdate.Open();
                        string queryupdate = @"UPDATE d SET momtaz =( isnull(momtaz,0) | 1) FROM [kharazmi].[FetchWebservice] d WHERE FDatekey = @FDatekey";


                        object rawConnection2 = Connections.StageDimdate.AcquireConnection(null);
                        var conn2 = (SqlConnection)rawConnection2;

                        using (SqlCommand cmd2 = new SqlCommand(queryupdate, conn2))
                        {
                            cmd2.Parameters.AddWithValue("@FDatekey", id);
                            int rowsAffected = cmd2.ExecuteNonQuery();
                        }

                    }
                }
                catch (Exception ex)
                {
                    this.ComponentMetaData.FireInformation(0, "CustomLog", $"exception: {ex.Message}", "", 0, ref fireAgain);

                }

            }


        }
        catch (Exception ex)
        {
            ComponentMetaData.FireError(0, "Error in API Call", ex.Message, "", 0, out fireAgain);
        }
    }

}
