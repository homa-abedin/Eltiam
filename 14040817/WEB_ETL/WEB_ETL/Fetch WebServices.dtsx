    public override void CreateNewOutputRows()
    {
        bool fireAgain = false;
        /*
          Add rows by calling the AddRow method on the member variable named "<Output Name>Buffer".
          For example, call MyOutputBuffer.AddRow() if your output was named "MyOutput".
        */
        try
        {
            object rawConnection = Connections.StageDimdate.AcquireConnection(null);
            var conn = (SqlConnection)rawConnection;
            var dates = new List<int>();
            string query = "SELECT Fdatekey FROM [kharazmi].[FetchWebservice] where ( toba is null or (toba & 1)=0)  and miladidate <= FORMAT( dateadd(day,-1,getdate()), 'yyyy-MM-dd')  ";

            using (SqlCommand cmd = new SqlCommand(query, conn))
            using (SqlDataReader reader = cmd.ExecuteReader())
                while (reader.Read())
                {
                    dates.Add(reader.GetInt32(0));
                }

            Connections.StageDimdate.ReleaseConnection(rawConnection);

            //this.ComponentMetaData.FireInformation(0, "CustomLog", $"تاریخ: {dates}", "", 0, ref fireAgain);

            foreach (int id in dates)
            {

                ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12;  ///*

                string url = $"http://188.75.106.98:9095/api/exServices/daroox/drx/SupplierGetinvProductsStock?scuCompanyID=2&totCostCenterID=-1&Fdate={id}&Tdate={id}";
                //this.ComponentMetaData.FireInformation(0, "CustomLog", $"آدرس: {url}", "", 0, ref fireAgain);

                string urltoken = "http://188.75.106.98:9095/api/token";

                using (var client = new HttpClient())
                {
                    using (var clienttoken = new HttpClient())
                    {
                        clienttoken.DefaultRequestHeaders.Add("accept", "*/*");
                        var serializer = new JavaScriptSerializer();
                        var formData = new Dictionary<string, string>
                            {
                                { "userName", "kharazmi" },
                                { "password", "kh2022d" },
                                { "grant_type", "password" }
                            };
                        var contenttoken = new FormUrlEncodedContent(formData);
                        var responsetoken = clienttoken.PostAsync(urltoken, contenttoken).ConfigureAwait(false).GetAwaiter().GetResult();
                        if (responsetoken.IsSuccessStatusCode)
                        {

                            var tokenjson = responsetoken.Content.ReadAsStringAsync().ConfigureAwait(false).GetAwaiter().GetResult();
                            //this.ComponentMetaData.FireInformation(0, "CustomLog", $"tokenjson: {tokenjson}", "", 0, ref fireAgain);
                            var token = serializer.Deserialize<Root>(tokenjson);

                            client.DefaultRequestHeaders.Add("accept", "application/json");
                            client.DefaultRequestHeaders.Add("Authorization", $"Bearer {token.access_token}");

                            var response = client.GetAsync(url).ConfigureAwait(false).GetAwaiter().GetResult();
                            string json = response.Content.ReadAsStringAsync().ConfigureAwait(false).GetAwaiter().GetResult();
                            //this.ComponentMetaData.FireInformation(0, "CustomLog", $"json: {json}", "", 0, ref fireAgain);

                            //https://json2csharp.com/
                            var list = serializer.Deserialize<Root1>(json);
                            foreach (var item in list.payloads.results)
                            {

                                //this.ComponentMetaData.FireInformation(0, "CustomLog", $"لیست: {list.payloads}", "", 0, ref fireAgain);

                                Output0Buffer.AddRow();
                                Output0Buffer.expireDate = item.ExpireDate;
                                Output0Buffer.serialNo = item.SerialNo;
                                Output0Buffer.stockQty = Convert.ToInt32(item.StockQty ?? 0);
                                Output0Buffer.darRahQty = Convert.ToInt32(item.DarRahQty ?? 0);
                                Output0Buffer.notDistributedQty = Convert.ToInt32(item.NotDistributedQty ?? 0);
                                Output0Buffer.costCenterID = item.totCostCenterID ?? 0;
                                Output0Buffer.costCenterName = item.totCostCenterName;
                                Output0Buffer.productID = item.invProductID;
                                Output0Buffer.productName = item.invProdctName;
                                Output0Buffer.stockAmount = item.StockAmnt ?? 0;
                                Output0Buffer.ZayeatQty = Convert.ToInt32(item.ZayeatQty ?? 0);
                                Output0Buffer.reservedQty = Convert.ToInt32(item.ReservedQty);
                                Output0Buffer.GTIN = null;
                                Output0Buffer.IRC = null;
                                Output0Buffer.datekey = id;
                                Output0Buffer.isinsert = 1;

                                

                            }
                        }
                        else
                        {
                            var tokenjson = responsetoken.Content.ReadAsStringAsync().ConfigureAwait(false).GetAwaiter().GetResult();
                            this.ComponentMetaData.FireInformation(0, "CustomLog", $"json: {tokenjson}", "", 0, ref fireAgain);



                        }
                    }
                }

                try
                {
                    string connStr = "Data Source=192.168.10.10;Initial Catalog=stage;Integrated Security=SSPI;";
                    using (SqlConnection connUpdate = new SqlConnection(connStr))
                    {
                        connUpdate.Open();
                        string queryupdate = @"UPDATE d SET toba =( isnull(toba,0) | 1) FROM [kharazmi].[FetchWebservice] d WHERE FDatekey = @FDatekey";


                        object rawConnection2 = Connections.StageDimdate.AcquireConnection(null);
                        var conn2 = (SqlConnection)rawConnection2;

                        using (SqlCommand cmd2 = new SqlCommand(queryupdate, conn2))
                        {
                            cmd2.Parameters.AddWithValue("@FDatekey", id);
                            int rowsAffected = cmd2.ExecuteNonQuery();
                            ComponentMetaData.FireInformation(0, "CustomLog", $"Updated ID {id}, rows affected: {rowsAffected}", "", 0, ref fireAgain);
                        }

                    }
                }
                catch (Exception ex)
                {
                    this.ComponentMetaData.FireInformation(0, "CustomLog", $"exception: {ex.Message}", "", 0, ref fireAgain);

                }

            }
        }
        catch (Exception ex)
        {

            ComponentMetaData.FireError(0, "Error in API Call", ex.Message, "", 0, out fireAgain);
        }

        Thread.Sleep(30000);
    }
    public class Root
    {
        public string access_token { get; set; }
        public string token_type { get; set; }
        public int expires_in { get; set; }
        public string refresh_token { get; set; }

        //    [JsonProperty(".issued")]
