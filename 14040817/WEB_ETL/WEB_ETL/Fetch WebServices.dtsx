    public class RootObject
    {
        public List<ForoshMarjoeeMoshtarianKalaInfo> result { get; set; }
    }
    public override void CreateNewOutputRows()
    {
        bool fireAgain = false;

        /*
          Add rows by calling the AddRow method on the member variable named "<Output Name>Buffer".
          For example, call MyOutputBuffer.AddRow() if your output was named "MyOutput".
        */
        try
        {
            object rawConnection = Connections.StageDimdate.AcquireConnection(null);
            var conn = (SqlConnection)rawConnection;

            var dates = new List<string>();
            string query = @"SELECT fjalali FROM [kharazmi].[FetchWebservice]
                         WHERE (alborz IS NULL OR (alborz & 2) = 0)
                         AND miladidate <= FORMAT(DATEADD(day, -1, GETDATE()), 'yyyy-MM-dd')";

            using (SqlCommand cmd = new SqlCommand(query, conn))
            using (SqlDataReader reader = cmd.ExecuteReader())
            {
                while (reader.Read())
                {
                    dates.Add(reader.GetString(0));
                }
            }


            Connections.StageDimdate.ReleaseConnection(rawConnection);

            foreach (var id in dates)

            {

                try
                {
                    ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12;


                string url = $"http://5.160.85.244:84/Supplier/Report/GetSaleAndStockwithbatch?apikey=6d46a2720de142a4a4dc2ce2331a7313&sDate={id}";


                    HttpWebRequest request = (HttpWebRequest)WebRequest.Create(url);
                request.Method = "GET";
                request.ContentType = "application/json";

               using (HttpWebResponse response = (HttpWebResponse)request.GetResponse())
                using (StreamReader reader = new StreamReader(response.GetResponseStream()))

                    {
                      string json = reader.ReadToEnd();


                        var serializer = new JavaScriptSerializer();
                    var root = serializer.Deserialize<RootObject>(json); // ← اصلاح مهم
                    //var list = root.result;
                        
                        foreach (var item in root?.result)
                    {

                        Output0Buffer.AddRow();

                        Output0Buffer.Distributor = "Alborz";
                        Output0Buffer.DistributorCode = 12000;
                        Output0Buffer.CenterCode =Convert.ToString( item.BranchCode ??  0);
                        Output0Buffer.Center = item.BranchName;
                        Output0Buffer.GoodsCode = item.GoodsCode;
                        Output0Buffer.GoodsName = item.GoodsName;
                        Output0Buffer.CountOfStock = item.CountOfStock  ?? 0;
                        Output0Buffer.AmountOfStock = item.AmountOfStock ?? 0;
                        Output0Buffer.BeinT = item.BeinT ?? 0;
                        Output0Buffer.BatchNo = item.BatchNo;
                        Output0Buffer.ExpireDate =Convert.ToDateTime( item.ExpireDate);
                        Output0Buffer.StockGh = item.StockGh ?? 0;
                        Output0Buffer.LastBuyPrice = item.LastBuyPrice ?? 0;
                        Output0Buffer.IsInsert = 1;
                        Output0Buffer.datekey =Convert.ToInt32( id.Replace("/",""));

                    }

                }

                    string connStr = "Data Source=192.168.10.10;Initial Catalog=stage;Integrated Security=SSPI;";
                    using (SqlConnection connUpdate = new SqlConnection(connStr))
                    {
                        connUpdate.Open();

                        string queryUpdate = @"UPDATE d SET alborz = (ISNULL(alborz, 0) | 2)
                                           FROM [kharazmi].[FetchWebservice] d
                                           WHERE fjalali = @fjalali";

                        using (SqlCommand cmdUpdate = new SqlCommand(queryUpdate, connUpdate))
