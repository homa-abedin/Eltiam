                          dataType="System.String"><![CDATA[using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace SC_bfedbef221d8482bbaac0c9686612bb4
{
    public class ForoshMarjoeeMoshtarianKalaInfo
    {
        public string Address { get; set; }
        public int CodeForoshandeh { get; set; }
