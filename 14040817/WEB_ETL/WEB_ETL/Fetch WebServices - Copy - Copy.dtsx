using System;
using System.Collections.Generic;
using System.Net.Http;
using System.Text;
using System.Web;
using System.Web.Script.Serialization;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
#endregion

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void CreateNewOutputRows()
    {
        bool fireAgain = false;
        try
        {
            string url = "http://188.75.73.76/suppliers_api/GetCustomers";
            string urltoken = "http://188.75.73.76/suppliers_api/Authentication/GetToken";

            var serializer = new JavaScriptSerializer();

            // --- گرفتن Token ---
            string token;
            using (var clienttoken = new HttpClient())
            {
                clienttoken.DefaultRequestHeaders.Clear();
                clienttoken.DefaultRequestHeaders.Add("accept", "*/*");

                var contenttoken = new StringContent(
                    serializer.Serialize(new { userName = "kharazmi", password = "Kg18725" }),
                    Encoding.UTF8,
                    "application/json"
                );

                using (contenttoken)
                using (var responsetoken = clienttoken.PostAsync(urltoken, contenttoken).GetAwaiter().GetResult())
                {
                    if (!responsetoken.IsSuccessStatusCode)
                        throw new Exception($"Token request failed: {responsetoken.StatusCode}");

                    var tokenRaw = responsetoken.Content.ReadAsStringAsync().GetAwaiter().GetResult();
                    token = tokenRaw.Trim('"');
                }
            }

            int i = 1;
            int pagetotal = 1;

            using (var client = new HttpClient())
            {
                client.DefaultRequestHeaders.Clear();
                client.DefaultRequestHeaders.Add("accept", "application/json");
                client.DefaultRequestHeaders.Add("Authorization", $"Bearer {token}");

                do
                {
                    var uriBuilder = new UriBuilder(url);
                    var query = HttpUtility.ParseQueryString(uriBuilder.Query);
                    query["PageNum"] = i.ToString();
                    query["PageSize"] = "1000";
                    uriBuilder.Query = query.ToString();

                    using (var response = client.GetAsync(uriBuilder.ToString()).GetAwaiter().GetResult())
                    {
                        string json = response.Content.ReadAsStringAsync().GetAwaiter().GetResult();

                        if (!response.IsSuccessStatusCode)
                            throw new Exception($"GetCustomers API failed. StatusCode: {response.StatusCode}, Body: {json}");

                        var list = serializer.Deserialize<Root2>(json);
                        if (list?.data != null)
                        {
                            foreach (var item in list.data)
                            {
                                Output0Buffer.AddRow();
                                Output0Buffer.customerKey = item.customerKey ?? 0;
                                Output0Buffer.customerCode = item.customerCode ?? 0;
                                Output0Buffer.isDeactivated = item.isDeactivated;
                                Output0Buffer.customer = item.customer;
                                Output0Buffer.centerKeyNow = item.centerKeyNow ?? 0;
                                Output0Buffer.centerNow = item.centerNow;
                                Output0Buffer.customerType = item.customerType;
                                Output0Buffer.pharmacyType = item.pharmacyType;
                                Output0Buffer.ownershipType = item.ownershipType;
                                Output0Buffer.regulatoryAgencyKey = item.regulatoryAgencyKey ?? 0;
                                Output0Buffer.regulatoryAgency = item.regulatoryAgency;

                                // gln امن
                                if (!string.IsNullOrWhiteSpace(item.gln) && long.TryParse(item.gln, out long glnValue))
                                    Output0Buffer.gln = glnValue;
                                else
                                    Output0Buffer.gln = 0;
                            }
                            pagetotal = (list.rowCount / 1000) + 1;
                        }
                        else
                        {
                            throw new Exception("No data returned from GetCustomers API.");
                        }
                    }

                    i++;
                    System.Threading.Thread.Sleep(200); // تاخیر کوچک بین درخواست‌ها
                }
                while (i <= pagetotal);
            }
        }
        catch (Exception ex)
        {
            ComponentMetaData.FireError(0, "Error in API Call",
                $"Message: {ex.Message} | Stack: {ex.StackTrace} | Inner: {ex.InnerException?.Message}",
                "", 0, out fireAgain);
        }
    }

    public class Root2
    {
        public int currentPage { get; set; }
        public int pageCount { get; set; }
        public int pageSize { get; set; }
        public int rowCount { get; set; }
        public List<Datum> data { get; set; }

        public class Datum
        {
            public int? customerKey { get; set; }
            public int? customerCode { get; set; }
            public bool isDeactivated { get; set; }
            public string customer { get; set; }
            public int? centerKeyNow { get; set; }
            public string centerNow { get; set; }
            public string customerType { get; set; }
            public string pharmacyType { get; set; }
            public string ownershipType { get; set; }
            public int? regulatoryAgencyKey { get; set; }
            public string regulatoryAgency { get; set; }
            public string gln { get; set; }
        }
    }
}
]]></arrayElement>
