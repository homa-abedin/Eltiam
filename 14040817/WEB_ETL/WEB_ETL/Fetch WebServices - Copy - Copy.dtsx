    public override void CreateNewOutputRows()
    {
        try
        {
            object rawConnection = Connections.StageDimdate.AcquireConnection(null);
            var conn = (SqlConnection)rawConnection;
            var dates = new List<int>();
            string query = "SELECT Fdatekey FROM [kharazmi].[FetchWebservice] where fdatekey  < 14040101 and( momtaz is null or (momtaz & 2)=0)  and miladidate <= FORMAT( dateadd(day,-1,getdate()), 'yyyy-MM-dd')  ";

            using (SqlCommand cmd = new SqlCommand(query, conn))
            using (SqlDataReader reader = cmd.ExecuteReader())
                while (reader.Read())
                {
                    dates.Add(reader.GetInt32(0));
                }
            Connections.StageDimdate.ReleaseConnection(rawConnection);

            foreach (var id in dates)
            {
                string url = "http://188.75.73.78/SupplierService/SupplierFile.asmx";
                string soapAction = "http://p-momtaz.com/saleProduct_Customer_WithPrize_Serial";
                string xml = $@"<?xml version=""1.0"" encoding=""utf-8""?>
                    <soap:Envelope xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" xmlns:xsd=""http://www.w3.org/2001/XMLSchema"" xmlns:soap=""http://schemas.xmlsoap.org/soap/envelope/"">
                      <soap:Body>
                        <saleProduct_Customer_WithPrize_Serial xmlns=""http://p-momtaz.com/"">
                          <UserName>kharazmi</UserName>
                          <Password>Ki3256</Password>
                          <FDate>{id}</FDate>
                          <TDate>{id}</TDate>
                        </saleProduct_Customer_WithPrize_Serial>
                      </soap:Body>
                    </soap:Envelope>";
                using (var client = new HttpClient() { Timeout = TimeSpan.FromSeconds(120) })
                {
                    var content = new StringContent(xml, Encoding.UTF8, "text/xml");
                    content.Headers.Add("SOAPAction", soapAction);
                    var response = client.PostAsync(url, content).GetAwaiter().GetResult();

                    if (!response.IsSuccessStatusCode)
                    {
                        return;
                    }


                    string result = response.Content.ReadAsStringAsync().GetAwaiter().GetResult();
                    XmlDocument doc = new XmlDocument();
                    doc.LoadXml(result);
                    XmlNamespaceManager nsmgr = new XmlNamespaceManager(doc.NameTable);
                    nsmgr.AddNamespace("soap", "http://schemas.xmlsoap.org/soap/envelope/");
                    nsmgr.AddNamespace("ns", "http://p-momtaz.com/");
                    XmlNodeList tableNodes = doc.SelectNodes("//ns:Momtaz_rptSP_Sale00201_WithPrize_GlobalWebservice_Dep_SerialResult", nsmgr);
                    this.ComponentMetaData.FireInformation(0, "CustomLog", $"result: {result}", "", 0, ref fireAgain);
                    foreach (XmlNode table in tableNodes)
                    {
                        int tempInt;
                        decimal tempdecimal;
                        Int64 templong;  
                        Output0Buffer.AddRow();
                        //Output0Buffer.Distributor = "Momtaz";
                        //Output0Buffer.DistributorCode = 48000;
                        Output0Buffer.Center = table["totCostCenterName"]?.InnerText;
                        Output0Buffer.CenterCode = int.TryParse(table["totCostCenterCode"]?.InnerText, out tempInt) ? tempInt : 0;
                        Output0Buffer.Product = table["invProductName"]?.InnerText;
                        Output0Buffer.ProductCode = int.TryParse(table["invProductCode"]?.InnerText, out tempInt) ? tempInt : 0;
                        Output0Buffer.CustomerCode = int.TryParse(table["totMergedPersonCode"]?.InnerText, out tempInt) ? tempInt : 0;
                        Output0Buffer.Customer = table["totMergedPersonName"]?.InnerText;
                        Output0Buffer.GLN = Int64.TryParse(table["GLN"]?.InnerText, out templong) ? templong : 0;
                        Output0Buffer.Address = table["Addresses"]?.InnerText;
                        var serials = table["Serials"]?.InnerText;
                        Output0Buffer.ShomarehFaktor =Convert.ToInt32( !string.IsNullOrWhiteSpace(serials) ? serials.Split(';')[0] : "");

                        Output0Buffer.Quantity = int.TryParse(table["Qty"]?.InnerText, out tempInt) ? tempInt : 0;
                        Output0Buffer.ReturnQty = int.TryParse(table["ReturnQty"]?.InnerText, out tempInt) ? tempInt : 0;
                        Output0Buffer.MasterQtyConfirmed = int.TryParse(table["MasterQtyConfirmed"]?.InnerText, out tempInt) ? tempInt : 0;
                        Output0Buffer.ReturnMasterQtyConfirmed = int.TryParse(table["ReturnMasterQtyConfirmed"]?.InnerText, out tempInt) ? tempInt : 0;
                        Output0Buffer.BaseQtyConfirmed = int.TryParse(table["BaseQtyConfirmed"]?.InnerText, out tempInt) ? tempInt : 0;
                        Output0Buffer.ReturnBaseQtyConfirmed = int.TryParse(table["ReturnBaseQtyConfirmed"]?.InnerText, out tempInt) ? tempInt : 0;
                        Output0Buffer.AmountPrice = decimal.TryParse(table["AmountPrice"]?.InnerText, out tempdecimal) ? tempdecimal : 0;
                        Output0Buffer.ReturnAmountPrice = decimal.TryParse(table["ReturnAmountPrice"]?.InnerText, out tempdecimal) ? tempdecimal : 0;
                        Output0Buffer.Price = decimal.TryParse(table["FeePrice"]?.InnerText, out tempdecimal) ? tempdecimal : 0;
                        Output0Buffer.AmountDiscount = decimal.TryParse(table["AmountDiscount"]?.InnerText, out tempdecimal) ? tempdecimal : 0;
                        Output0Buffer.ReturnAmountDiscount = decimal.TryParse(table["ReturnAmountDiscount"]?.InnerText, out tempdecimal) ? tempdecimal : 0;
                        Output0Buffer.FinalAmount = decimal.TryParse(table["FinalAmount"]?.InnerText, out tempdecimal) ? tempdecimal : 0;
                        Output0Buffer.FinalAmountPrice = decimal.TryParse(table["FinalAmountPrice"]?.InnerText, out tempdecimal) ? tempdecimal : 0;
                        Output0Buffer.saleCustomerTypeID = int.TryParse(table["saleCustomerTypeID"]?.InnerText, out tempInt) ? tempInt : 0;
                        Output0Buffer.saleCustomerActivityID = int.TryParse(table["saleCustomerActivityID"]?.InnerText, out tempInt) ? tempInt : 0;
                        Output0Buffer.QtyConfirmed = int.TryParse(table["QtyConfirmed"]?.InnerText, out tempInt) ? tempInt : 0;
                        Output0Buffer.invOperationCode = int.TryParse(table["invOperationCode"]?.InnerText, out tempInt) ? tempInt : 0;
                        Output0Buffer.Date = int.TryParse(table["ExecDate"]?.InnerText, out tempInt) ? tempInt : 0;
                        Output0Buffer.IsInsert = 1;



                    }
                }
                try
                {
                    string connStr = "Data Source=192.168.10.10;Initial Catalog=stage;Integrated Security=SSPI;";
                    using (SqlConnection connUpdate = new SqlConnection(connStr))
                    {
                        connUpdate.Open();
                        string queryupdate = @"UPDATE d SET momtaz =( isnull(momtaz,0) | 2) FROM [kharazmi].[FetchWebservice] d WHERE FDatekey = @FDatekey";


                        object rawConnection2 = Connections.StageDimdate.AcquireConnection(null);
                        var conn2 = (SqlConnection)rawConnection2;

                        using (SqlCommand cmd2 = new SqlCommand(queryupdate, conn2))
                        {
                            cmd2.Parameters.AddWithValue("@FDatekey", id);
                            int rowsAffected = cmd2.ExecuteNonQuery();
                        }

                    }
                }
                catch (Exception ex)
                {
                    this.ComponentMetaData.FireInformation(0, "CustomLog", $"exception: {ex.Message}", "", 0, ref fireAgain);

                }
            }
        }

        catch (Exception ex)
        {
            bool fireAgain = false;
            ComponentMetaData.FireError(0, "خطا در دریافت اطلاعات فروش از مشتریان", ex.Message, "", 0, out fireAgain);
        }
            }

        }
        
