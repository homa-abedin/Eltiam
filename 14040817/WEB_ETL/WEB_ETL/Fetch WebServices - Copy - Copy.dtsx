    public override void CreateNewOutputRows()
    {
        bool fireAgain = false;
        /*
          Add rows by calling the AddRow method on the member variable named "<Output Name>Buffer".
          For example, call MyOutputBuffer.AddRow() if your output was named "MyOutput".
        */
        try
        {
            object rawConnection = Connections.StageDimdate.AcquireConnection(null);
            var conn = (SqlConnection)rawConnection;
            var dates = new List<string>();
            string query = "SELECT fjalali FROM [kharazmi].[FetchWebservice] where ( hasti is null or (hasti & 1)=0)  and miladidate <= FORMAT( dateadd(day,-1,getdate()), 'yyyy-MM-dd')  ";

            using (SqlCommand cmd = new SqlCommand(query, conn))
            using (SqlDataReader reader = cmd.ExecuteReader())
                while (reader.Read())
                {
                    dates.Add(reader.GetString(0));
                }

            Connections.StageDimdate.ReleaseConnection(rawConnection);


            foreach (string id in dates)
            {
                string url = "http://5.160.151.74:25684/ReportService.svc/json/Get_sp_AllData";
                using (var client = new HttpClient())
                {
                    client.DefaultRequestHeaders.Add("accept", "application/json");
                    var serializer = new JavaScriptSerializer();
                    var content = new StringContent(
                    serializer.Serialize(new
                    {
                        Token = "24852246",
                        UserName = "KHA111",
                        Password = "sph!@#1431",
                        TypeID = 14,
                        FromDate = id,
                        ToDate = id

                    }), null, "application/json");

                    var response = client.PostAsync(url, content).GetAwaiter().GetResult();

                    string json = response.Content.ReadAsStringAsync().GetAwaiter().GetResult();
                    this.ComponentMetaData.FireInformation(0, "CustomLog", $"json: {json}", "", 0, ref fireAgain);

                    //https://json2csharp.com/
                    var list = serializer.Deserialize<Root1>(json);


                    foreach (var item in list._Report_01)
                    {
                        Output0Buffer.AddRow();
                        Output0Buffer.BatchNo = item.BatchNo;
                        Output0Buffer.DSID = item.DSID ?? 0;
                        Output0Buffer.DSName = item.DSName;
                        Output0Buffer.ExpDate =Convert.ToInt32(item.ExpDate.Replace("/", ""));
                        Output0Buffer.ExpDateMiladi = item.ExpDateMiladi;
                        Output0Buffer.GTIN =Convert.ToInt64( item.GTIN);
                        Output0Buffer.IRC = item.IRC;
                        Output0Buffer.InWay = item.InWay ?? 0;
                        Output0Buffer.ProdID = item.ProdID;
                        Output0Buffer.ProdName = item.ProdName;
                        Output0Buffer.QtystockPrice = item.QtystockPrice ?? 0;
                        Output0Buffer.QtyStock = item.QtyStock ?? 0;
                        Output0Buffer.isinsert = 1;
                        Output0Buffer.datekey =Convert.ToInt32( id.Replace("/",""));

                    }
                }
                try
                {
                    string connStr = "Data Source=192.168.10.10;Initial Catalog=stage;Integrated Security=SSPI;";
                    using (SqlConnection connUpdate = new SqlConnection(connStr))
                    {
                        connUpdate.Open();
                        string queryupdate = @"UPDATE d SET hasti =( isnull(hasti,0) | 1) FROM [kharazmi].[FetchWebservice] d WHERE fjalali = @fjalali";


                        object rawConnection2 = Connections.StageDimdate.AcquireConnection(null);
                        var conn2 = (SqlConnection)rawConnection2;

                        using (SqlCommand cmd2 = new SqlCommand(queryupdate, conn2))
                        {
                            cmd2.Parameters.AddWithValue("@fjalali", id);
                            int rowsAffected = cmd2.ExecuteNonQuery();
                            ComponentMetaData.FireInformation(0, "CustomLog", $"Updated ID {id}, rows affected: {rowsAffected}", "", 0, ref fireAgain);
                        }
                    }
                }
                catch (Exception ex)
                {
                    this.ComponentMetaData.FireInformation(0, "CustomLog", $"exception: {ex.Message}", "", 0, ref fireAgain);

                }
            }

        }
        catch (Exception ex)
        {

            ComponentMetaData.FireError(0, "Error in API Call", ex.Message, "", 0, out fireAgain);
        }
    }




    public class Result
    {
        public string BatchNo { get; set; }
        public int?  DSID { get; set; }
        public string DSName { get; set; }
        public string ExpDate { get; set; }
        public string ExpDateMiladi { get; set; }
        public string GTIN { get; set; }
        public string IRC { get; set; }
        public string ProdID { get; set; }
        public string ProdName { get; set; }
        public decimal? QtystockPrice { get; set; }
        public int? QtyStock { get; set; }
        
        public int? InWay { get; set; }
        

    }

    public class Root1
    {
        public string Description { get; set; }
        public bool State { get; set; }
        public List<Result> _Report_01 { get; set; }
        //public Payloads _Report_01 { get; set; }
        
    }
}]]></arrayElement>
