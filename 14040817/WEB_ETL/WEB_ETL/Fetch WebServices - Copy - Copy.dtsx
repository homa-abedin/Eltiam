    public override void CreateNewOutputRows()
    {
        bool fireAgain = false;

        /*
          Add rows by calling the AddRow method on the member variable named "<Output Name>Buffer".
          For example, call MyOutputBuffer.AddRow() if your output was named "MyOutput".
        */
        try
        {
            object rawConnection = Connections.StageDimdate.AcquireConnection(null);
            var conn = (SqlConnection)rawConnection;
            var dates = new List<string>();
            string query = "SELECT FJalali FROM [kharazmi].[FetchWebservice] where ( Ferdos is null or (Ferdos & 1)=0)  and miladidate <= FORMAT( dateadd(day,-1,getdate()), 'yyyy-MM-dd') and fdatekey>=14040101 ";

            using (SqlCommand cmd = new SqlCommand(query, conn))
            using (SqlDataReader reader = cmd.ExecuteReader())
                while (reader.Read())
                {
                    dates.Add(reader.GetString(0));
                }

            Connections.StageDimdate.ReleaseConnection(rawConnection);

            try
            {
                ServicePointManager.SecurityProtocol = SecurityProtocolType.Tls12;

                foreach (string id in dates)
                {
                    string url = $"https://www.ferdowsdco.com/services/api/Supplier/GetInvoiceDetail?FromDate={id}&ToDate={id}";
                    string urltoken = "https://www.ferdowsdco.com/services/api/Authentication/GetToken";
                    using (var client = new HttpClient())
                    {
                        using (var clienttoken = new HttpClient())
                        {
                            clienttoken.DefaultRequestHeaders.Add("accept", "*/*");
                            var serializer = new JavaScriptSerializer();
                            var contenttoken = new StringContent(
                                serializer.Serialize(new
                                {
                                    userName = "daroosazi.kharazmi",
                                    password = "d1398",
                                }), null, "application/json");

                            var responsetoken = clienttoken.PostAsync(urltoken, contenttoken).GetAwaiter().GetResult();

                            if (responsetoken.IsSuccessStatusCode)
                            {

                                var tokenjson = responsetoken.Content.ReadAsStringAsync().GetAwaiter().GetResult();
                                var token = serializer.Deserialize<FerdowsdcoToken>(tokenjson);

                                client.DefaultRequestHeaders.Add("accept", "application/json");
                                client.DefaultRequestHeaders.Add("Authorization", $"Bearer {token.data.token}");

                                var response = client.GetAsync(url).GetAwaiter().GetResult();
                                string json = response.Content.ReadAsStringAsync().GetAwaiter().GetResult();
                                //this.ComponentMetaData.FireInformation(0, "CustomLog", $"json: {json}", "", 0, ref fireAgain);
                                //https://json2csharp.com/
                                var list = serializer.Deserialize<Root>(json);
                                this.ComponentMetaData.FireInformation(0, "CustomLog", $"json: {json}", "", 0, ref fireAgain);

                                foreach (var item in list.data)
                                {
                                    Output0Buffer.AddRow();
                                    Output0Buffer.invoiceDate = Convert.ToInt32(item.invoiceDate.Replace("/", ""));
                                    Output0Buffer.invoiceNo = Convert.ToInt64(item.invoiceNo ?? 0);
                                    Output0Buffer.centerWarehouseId = item.centerWarehouseId ?? 0;
                                    Output0Buffer.warehouseId = item.warehouseId ?? 0;
                                    Output0Buffer.warehouseName = item.warehouseName;
                                    Output0Buffer.warehouseOfficeName = item.warehouseOfficeName;
                                    Output0Buffer.customerCode = item.customerCode;
                                    Output0Buffer.customerName = item.customerName;
                                    Output0Buffer.provinceCode = item.provinceCode ?? 0;
                                    Output0Buffer.provinceName = item.provinceName;
                                    Output0Buffer.productCode = item.productCode;
                                    Output0Buffer.productName = item.productName;
                                    Output0Buffer.quantity = item.quantity ?? 0;
                                    Output0Buffer.expireDate = Convert.ToString(item.expireDate);
                                    Output0Buffer.batchNo = item.batchNo;
                                    Output0Buffer.productPrice = item.productPrice;
                                    Output0Buffer.documentType = item.documentType;
                                    Output0Buffer.documentTypeId = item.documentTypeId ?? 0;
                                    if (item != null && !string.IsNullOrWhiteSpace(item.gln))
                                    {
                                        Output0Buffer.gln = Convert.ToInt64(item.gln);
                                    }

                                    Output0Buffer.customerType = item.customerType;
                                    Output0Buffer.customerTypeId = item.customerTypeId ?? 0;
                                    Output0Buffer.uniqueId = Convert.ToString(item.uniqueId ?? 0);
                                    Output0Buffer.buyFee = item.buyFee;
                                    Output0Buffer.endUserFee = item.endUserFee;
                                    Output0Buffer.refInvoiceNo = item.refInvoiceNo;
                                    if (item != null && !string.IsNullOrWhiteSpace(item.refInvoiceDate))
                                    {
                                        Output0Buffer.refInvoiceDate = Convert.ToInt32(item.refInvoiceDate.Replace("/", ""));
                                    }
                                    Output0Buffer.isinsert = 1;


                                }
                            }
                           
                        }
                    }


                    string connStr = "Data Source=192.168.10.10;Initial Catalog=stage;Integrated Security=SSPI;";
                    using (SqlConnection connUpdate = new SqlConnection(connStr))
                    {
                        connUpdate.Open();

                        string queryupdate = @"UPDATE d SET ferdos =( isnull(ferdos,0) | 1) FROM [kharazmi].[FetchWebservice] d WHERE Fjalali = @Fjalali";


                        object rawConnection2 = Connections.StageDimdate.AcquireConnection(null);
                        var conn2 = (SqlConnection)rawConnection2;

                        using (SqlCommand cmd2 = new SqlCommand(queryupdate, conn2))
                        {
                            cmd2.Parameters.AddWithValue("@Fjalali", id);
                            int rowsAffected = cmd2.ExecuteNonQuery();
                            ComponentMetaData.FireInformation(0, "CustomLog", $"Updated ID {id}, rows affected: {rowsAffected}", "", 0, ref fireAgain);
                        }
                    }
                }
            }

            catch (Exception ex)
            {
                this.ComponentMetaData.FireInformation(0, "CustomLog", $"exception: {ex.Message}", "", 0, ref fireAgain);

            }

            
        }
        catch (Exception ex)
        {
            
    ComponentMetaData.FireError(0, "Error in API Call", ex.Message, "", 0, out fireAgain);
        }
    }
    public class FerdowsdcoToken
    {
        public Token data { get; set; }
        public List<string> messages { get; set; }
        public class Token
        {
            public string token { get; set; }
        }
    }
    
    }


    public class Root
{
    public List<Datum> data { get; set; }
    public List<object> messages { get; set; }
    public int ? status { get; set; }
    public string statusName { get; set; }
    public int ? totalRecords { get; set; }
    public class Datum
    {
        public string invoiceDate { get; set; }
        public int ? invoiceNo { get; set; }
        public int? centerWarehouseId { get; set; }
        public int? warehouseId { get; set; }
        public string warehouseName { get; set; }
        public string warehouseOfficeName { get; set; }
        public string customerCode { get; set; }
        public string customerName { get; set; }
        public int? provinceCode { get; set; }
        public string provinceName { get; set; }
        public string productCode { get; set; }
        public string productName { get; set; }
        public int? quantity { get; set; }
        public int? expireDate { get; set; }
        public string batchNo { get; set; }
        public decimal productPrice { get; set; }
        public string documentType { get; set; }
        public int? documentTypeId { get; set; }
        public string gln { get; set; }
        public string customerType { get; set; }
        public int? customerTypeId { get; set; }
      
        public int? uniqueId { get; set; }
        public decimal buyFee { get; set; }
        public decimal endUserFee { get; set; }
        public string refInvoiceNo { get; set; }
        public string refInvoiceDate { get; set; }
    }
}
