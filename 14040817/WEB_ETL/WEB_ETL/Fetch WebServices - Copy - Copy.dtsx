            throw new ArgumentOutOfRangeException("سال مقدار قابل قبول ندارد");             if (month < 1 || month > 12)                 throw new ArgumentOutOfRangeException("ماه مقدار قابل قبول ندارد");             if (day < 1 || day > 31)                 throw new ArgumentOutOfRangeException("روز مقدار قابل قبول ندارد");               PersianCalendar pc = new PersianCalendar();             DateTime? dt2 = null;             if (ad.Count() >= 3)             {                 dt2 = pc.ToDateTime(year, month, day, 0,0,0,0);                 if (ad.Count() >= 6)                 {                     dt2 = pc.ToDateTime(year, month, day, hour, minutes, second, 0);                      //DateTime dt = DateTime.Parse(date, new CultureInfo("fa-IR"));                     //var dt_utc = dt.ToUniversalTime();                     //var tt = Convert.ToDateTime(date, new CultureInfo("fa-IR"));                 }             }             return dt2;         }         else             return null;     }     public  string GregorianToPersianFormat( DateTime date, string format = "yyyy/MM/dd")     {          PersianCalendar pc = new PersianCalendar();         var result = format;          result = result.Replace("yyyy", pc.GetYear(date).ToString("0000"));         result = result.Replace("MM", pc.GetMonth(date).ToString("00"));         result = result.Replace("dd", pc.GetDayOfMonth(date).ToString("00"));         result = result.Replace("hh", pc.GetHour(date).ToString("00"));         result = result.Replace("mm", pc.GetMinute(date).ToString("00"));         result = result.Replace("ss", pc.GetSecond(date).ToString("00"));         return result;     }     public  string GregorianToPersianFormat( DateTime? date, string format = "yyyy/MM/dd")     {         if (date == null)             return "";          PersianCalendar pc = new PersianCalendar();         var result = format;          result = result.Replace("yyyy", pc.GetYear(date.Value).ToString("0000"));         result = result.Replace("MM", pc.GetMonth(date.Value).ToString("00"));         result = result.Replace("dd", pc.GetDayOfMonth(date.Value).ToString("00"));         result = result.Replace("hh", pc.GetHour(date.Value).ToString("00"));         result = result.Replace("mm", pc.GetMinute(date.Value).ToString("00"));         result = result.Replace("ss", pc.GetSecond(date.Value).ToString("00"));         return result;     } }]]></arrayElement>
