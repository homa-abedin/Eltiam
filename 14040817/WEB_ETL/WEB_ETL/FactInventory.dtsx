                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">delete from Stage.web.Momtaz_InventoryNew
where quantity is null



select  
i.datekey
,p.kharazmi productcode
, c.id as centerid
,sku.Id BatchNo
,sku.ExpireDate ExpDate
,quantity QtyStock 
,qtyOnTheWay InWay
, cast (dpp.fee as bigint)  Fee1
,N'momtaz' as pakhsh
, 48000 as valuepakhsh
--select *
from Stage.web.Momtaz_InventoryNew i  
join (select * from dw.kharazmi.DimCenterPakhsh ) c on c.momtaz1404=i.centerKey
join (select * from web.Momtaz_Products) s on s.productKey= i.productKey
join (select distinct momtaz, kharazmi from web.mapproduct) p on p.momtaz=s.productCode
join (select * from web.Momtaz_SKUs) s1 on s1.skuKey= i.skuKey
join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= s1.batchNumber  
join (select * from dw.kharazmi.DimPRoductPrice) dpp on dpp.productcode=p.kharazmi and i.DateKey &gt;= dpp.StartDate and  i.DateKey&lt; dpp.EndDate 

where 

isinsert =1</property>
