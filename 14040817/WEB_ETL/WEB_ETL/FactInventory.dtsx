                      refId="Package\Inventory\Eltiam\OLE DB Source.Outputs[OLE DB Source Output]"
                      name="OLE DB Source Output">
                      <outputColumns>
                        <outputColumn
                          refId="Package\Inventory\Eltiam\OLE DB Source.Outputs[OLE DB Source Output].Columns[datekey]"
                          dataType="i4"
                          errorOrTruncationOperation="Conversion"
                          errorRowDisposition="FailComponent"
                          externalMetadataColumnId="Package\Inventory\Eltiam\OLE DB Source.Outputs[OLE DB Source Output].ExternalColumns[datekey]"
                          lineageId="Package\Inventory\Eltiam\OLE DB Source.Outputs[OLE DB Source Output].Columns[datekey]"
                          name="datekey"
                          truncationRowDisposition="FailComponent" />
                        <outputColumn
                          refId="Package\Inventory\Eltiam\OLE DB Source.Outputs[OLE DB Source Output].Columns[FiscalYearKey]"
                          dataType="i4"
                          errorOrTruncationOperation="Conversion"
