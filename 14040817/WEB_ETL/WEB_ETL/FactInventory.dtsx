                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select i.date as datekey
,p.kharazmi productcode
, c.id as centerid
,sku.id BatchNo
,sku.ExpireDate ExpDate
,QtyInventory QtyStock 
,0 InWay
, cast (dpp.fee as bigint)  Fee1
,N'Behestan' as pakhsh, 69257 as valuepakhsh
--select *
from Stage.web.Behestan i  
join (select * from dw.kharazmi.DimCenterPakhsh) c on c.behestan=i.CenterCode
join (select distinct kharazmi, behestan from web.mapproduct) p on p.behestan=i.ProductCode
join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= i.batch
join (select * from dw.kharazmi.DimPRoductPrice) dpp on dpp.productcode=p.kharazmi and i.date &gt;= dpp.StartDate and  i.date&lt; dpp.EndDate 


where
isinsert=1</property>
