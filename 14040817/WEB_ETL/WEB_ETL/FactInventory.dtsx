                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select i.datekey
,p.kharazmi productcode
, c.id as centerid
,sku.Id BatchNo
,sku.ExpireDate ExpDate
,InventoryCount QtyStock 
,InventoryAway InWay
--,InventoryAmount QtystockPrice
,N'barij' as pakhsh
, 69319 as valuepakhsh
, cast (dpp.fee as bigint)  Fee1
--select *
from Stage.web.Barij_Inventory i  
join (select * from dw.kharazmi.DimCenterPakhsh) c on c.Barij=i.CenterCode
join (select  distinct barij , kharazmi from web.mapproduct) p on p.Barij=i.ProductCode
join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= i.batch
join (select * from dw.kharazmi.DimPRoductPrice) dpp on dpp.productcode=p.kharazmi and i.DateKey &gt;= dpp.StartDate and  i.DateKey&lt; dpp.EndDate 
 --where   p.kharazmi   is null

where  isinsert=1</property>
