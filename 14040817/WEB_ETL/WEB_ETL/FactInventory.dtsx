                <component
                  refId="Package\Inventory\Inventory\qasem"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="qasem"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select   datekey
,p.kharazmi productcode
, dc.id as centerid
,sku.Id as BatchNo
,sku.ExpireDate ExpDate
,InventoryCount QtyStock 
,InventoryAway InWay
, cast (dpp.fee as bigint)  Fee1
,N'Qhasem' as pakhsh
, 29000 as valuepakhsh
--select  *
FROM web.Qhasem_Inventory  s
JOIN (select * from dw.kharazmi.DimCenterPakhsh ) dc ON dc.Qasem = s.CenterCode
join (select distinct kharazmi, qasem  from web.mapproduct) p on p.qasem=s.ProductCode
join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= s.Batch
join (select * from dw.kharazmi.DimPRoductPrice) dpp on dpp.productcode=p.kharazmi and s.DateKey &gt;= dpp.StartDate and  s.DateKey&lt; dpp.EndDate 

where  

isinsert =1</property>
