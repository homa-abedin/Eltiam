                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">delete from Stage.web.Mahya_Inventory
where ProductCode is null


select i.datekey
,p.kharazmi productcode
, c.id as centerid
,sku.Id BatchNo
,sku.ExpireDate ExpDate
,InventoryCount QtyStock 
,InventoryAway InWay
,cast(dpp.fee as bigint ) Fee1
,N'mahya' as pakhsh
, 47000 as valuepakhsh
--select count(*)
from Stage.web.Mahya_Inventory i
join (select * from dw.kharazmi.DimCenterPakhsh) c on c.Mahya=i.CenterCode
join (select mahya, kharazmi from web.mapproduct) p on p.mahya=i.ProductCode
join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= i.batch
join (select * from dw.kharazmi.DimPRoductPrice) dpp on dpp.productcode=p.kharazmi and i.DateKey &gt;= dpp.StartDate and i.DateKey&lt; dpp.EndDate 

where 
--i.DateKey&gt;=14040101
isinsert=1</property>
