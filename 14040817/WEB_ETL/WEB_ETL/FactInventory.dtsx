                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select i.date as datekey
,p.kharazmi productcode
, c.id as centerid
, sku.Id  BatchNo
,sku.ExpireDate ExpDate
,RemainQuantity QtyStock 
,RemainInwayQuantity InWay
, cast (dpp.fee as bigint)  Fee1
,N'same' as pakhsh
, 52000 as valuepakhsh
--select *
from Stage.web.samen_Inventory i  
join (select * from dw.kharazmi.DimCenterPakhsh) c on c.Samen=i.CenterCode
