                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">delete
from Stage.web.Daya_inventory 
where ProductId is null



select 
i.date datekey
,p.kharazmi productcode
, c.id as centerid
,sku.Id BatchNo
,sku.ExpireDate ExpDate
,InventoryQty QtyStock 
,OnWayQty InWay
,cast(dpp.fee as bigint ) Fee1
,N'daya' as pakhsh
, 69238 as valuepakhsh
--select *
from Stage.web.Daya_inventory i --703806
join (select * from dw.kharazmi.DimCenterPakhsh) c on c.Daya=i.CenterId
join (select  distinct daya, kharazmi from web.mapproduct) p on p.daya=i.ProductId
join (select * from dw.kharazmi.dimsku)sku on sku.productcode=  p.kharazmi and sku.batchno= i.BatchNumber
join (select * from dw.kharazmi.DimPRoductPrice) dpp on dpp.productcode=p.kharazmi and i.date &gt;= dpp.StartDate and  i.date&lt; dpp.EndDate 

where isinsert=1</property>
