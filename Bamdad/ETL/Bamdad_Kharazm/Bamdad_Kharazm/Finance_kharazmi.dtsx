      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{BC53E516-3AD2-414F-8C2D-09E3408E9956}"
          SQLTask:SqlStatementSource="drop table if exists [DW].[kharazmi].[DimAccount]&#xA;GO&#xA;select * into [DW].[kharazmi].[DimAccount] from&#xA;(&#xA;&#xA;&#xA;SELECT&#x9;&#xA;&#x9;EntityID = CAST(SL.Code AS int), &#xA;&#x9;SLID = CAST(SL.SLID AS int),&#xA;&#x9;PLID = CAST(PL.AccountGroupID AS int),&#xA;&#x9;GLID = CAST(GL.GLID AS int),&#xA;&#x9;Title = CAST(SL.Title AS nvarchar(255)),&#xA;&#x9;PLTitle = CAST(PL.Title AS nvarchar(255)),&#xA;&#x9;GLTitle = CAST(GL.Title AS nvarchar(255)),&#xA;&#x9;EnglishTitle = CAST(ISNULL(NULLIF(SL.Title_En, ''), SL.Title) AS nvarchar(255)),&#xA;&#x9;EnglishPLTitle = CAST(ISNULL(NULLIF(PL.Title_En, ''), PL.Title) AS nvarchar(255)),&#xA;&#x9;EnglishGLTitle = CAST(ISNULL(NULLIF(GL.Title_En, ''), GL.Title) AS nvarchar(255)),&#xA;&#x9;cast(pl.code as int) as plcode,&#xA;&#x9;cast(gl.code as int) as glcode,&#xA;&#x9;cast(sl.code as int) as slcode&#x9;&#xA;FROM&#x9;[kharazmi].[FIN3SL] SL &#xA;left JOIN&#x9;[kharazmi].[FIN3GL] GL ON SL.GLRef = GL.GLID&#xA;left JOIN&#x9;[kharazmi].[FIN3AccountGroup] PL ON GL.AccountGroupRef = PL.AccountGroupID&#xA;&#xA;&#xA;)a" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
