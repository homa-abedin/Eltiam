      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\Delete fact extra"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{ABC76DB0-5DCA-4395-B6BE-D67F263246C7}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Delete fact extra"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{BC53E516-3AD2-414F-8C2D-09E3408E9956}"
              SQLTask:SqlStatementSource="delete    [dw].[kharazmi].[FactFinance]  WHERE  &#xA;&#xA;NOT EXISTS (&#xA;SELECT * FROM [kharazmi].[FIN3VoucherItem] vi WHERE  vi.VoucherItemID=[FactFinance].VoucherItemid&#x9;&#xA;&#xA;)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\delete isupdate1"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C26DDF81-DE22-4905-A4C5-6434D5A5B6BD}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="delete isupdate1"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{BC53E516-3AD2-414F-8C2D-09E3408E9956}"
              SQLTask:SqlStatementSource="  delete final &#xA;  from  [Stage].[kharazmi].[FIN3Voucher] firstin&#xA; inner join (select * from [DW].[kharazmi].[FactFinance]) final  on final.voucherid=firstin.voucherid &#xA;  WHERE &#xA;  firstin.isupdate=1 &#xA;  &#xA; GO&#xA;&#xA; delete final &#xA;  from [Stage].[kharazmi].[FIN3VoucherItem] firstin&#xA; inner join (select * from [DW].[kharazmi].[FactFinance]) final  on  firstin.VoucherItemid=final.VoucherItemid&#xA;  WHERE &#xA;  firstin.isupdate=1 " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\FactFinance"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{808E5048-2E4D-4836-B217-0DA944D8F42B}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="FactFinance"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{BC53E516-3AD2-414F-8C2D-09E3408E9956}"
              SQLTask:SqlStatementSource="INSERT INTO [DW].[kharazmi].[FactFinance] (&#xA;    Voucherid,&#xA;    VoucherItemid,&#xA;    Datekey,&#xA;    AccountingVoucherTypeID,&#xA;    AccountingVoucherStateID,&#xA;    BranchID,&#xA;    AccountID,&#xA;    DL4ID,&#xA;    DL5ID,&#xA;    DL6ID,&#xA;    Debit,&#xA;    Credit,&#xA;    DebitBalance&#xA;)&#xA;SELECT&#xA;    Voucherid,&#xA;    VoucherItemid,&#xA;    d.datekey,  -- datetime&#xA;    H.VoucherTypeRef,  -- bigint&#xA;    H.State,   -- int&#xA;    H.BranchRef,  -- bigint&#xA;    CAST(SL.code AS bigint),  -- bigint&#xA;    DL.DLID,  -- bigint&#xA;    ISNULL(CAST(DL5.DLID AS bigint),0),  -- bigint&#xA;    ISNULL(CAST(DL6.DLID AS bigint),0),  -- bigint&#xA;    cast ( ISNULL(I.Debit,0)as decimal(18,0)),  -- decimal&#xA;    cast (ISNULL(I.Credit,0)as decimal(18,0)),  -- decimal&#xA;    cast ( (ISNULL(I.Debit,0) - ISNULL(I.Credit,0))as decimal(18,0))  -- decimal&#xA;&#xA;&#xA;FROM [kharazmi].[FIN3VoucherItem] I&#xA;JOIN [kharazmi].[FIN3Voucher] H ON H.VoucherID = I.VoucherRef&#xA;JOIN [kharazmi].[FIN3VoucherType] VT ON VT.VoucherTypeID = H.VoucherTypeRef&#xA;JOIN [kharazmi].[FIN3SL] SL ON I.SLRef = SL.SLID&#xA;LEFT JOIN [kharazmi].[FIN3DL] DL ON DL.code = I.DLLevel4 COLLATE DATABASE_DEFAULT &#xA;LEFT JOIN [kharazmi].[FIN3DL] DL5 ON DL5.Code = I.DLLevel5 COLLATE DATABASE_DEFAULT &#xA;LEFT JOIN [kharazmi].[FIN3DL] DL6 ON DL6.Code = I.DLLevel6 COLLATE DATABASE_DEFAULT &#xA;join (select * from dw..dimdate)d on d.Date= h.Date&#xA;WHERE  H.State &lt;&gt; 2&#xA;and( i.isinsert=1 or h.isinsert=1)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\isinsert0"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{54A3DFFB-02D9-4621-9C1F-EC99A07FF553}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:MaxErrorCount="10"
          DTS:ObjectName="isinsert0"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{BC53E516-3AD2-414F-8C2D-09E3408E9956}"
              SQLTask:SqlStatementSource="   update firstin  &#xA;set &#xA;   firstin.isinsert=null&#xA;   &#xA;   --select COUNT(*)&#xA;   from [Stage].[Kharazmi].[FIN3Voucher]  firstin&#xA;   --JOIN  [Stage].[Kharazmi].[FIN3VoucherItem] vi ON vi.voucherref=firstin.voucherid&#xA; inner join (select * from [DW].[kharazmi].[FactFinance] r) final  on final.voucherid=firstin.voucherid &#xA; where  firstin.isinsert=1 &#xA;&#xA; GO&#xA;&#xA;    update firstin  &#xA;set &#xA;   firstin.isinsert=null&#xA;   --select count(*)&#xA;   from [Stage].[Kharazmi].[FIN3VoucherItem] firstin&#xA; inner join (select * FROM [DW].[kharazmi].[FactFinance]) final  on final.VoucherItemid=firstin.VoucherItemid&#xA; where  firstin.isinsert=1 &#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\isupdate0"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{6E109811-B2BA-4351-BF05-EEAE0079F6CF}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="isupdate0"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{BC53E516-3AD2-414F-8C2D-09E3408E9956}"
              SQLTask:SqlStatementSource="   update firstin  &#xA;set &#xA;   firstin.isupdate=null&#xA;   &#xA;   --select COUNT(*)&#xA;   from [kharazmi].[FIN3Voucher] firstin&#xA; inner join (select * from [dw].[kharazmi].[FactFinance]) final  on final.voucherid=firstin.voucherid  where  firstin.isupdate=1 &#xA;&#xA; GO&#xA;&#xA;    update firstin  &#xA;set &#xA;   firstin.isupdate=null&#xA;   --select count(*)&#xA;   from [kharazmi].[FIN3VoucherItem] firstin&#xA; inner join (select * FROM [dw].[kharazmi].[FactFinance]) final  on final.VoucherItemid=firstin.VoucherItemid&#xA; where  firstin.isupdate=1 &#xA;&#xA; GO&#xA; &#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Sequence Container\updateFactFinance"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C1197585-CEC7-4922-9AE3-183C59CD9C85}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="updateFactFinance"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{BC53E516-3AD2-414F-8C2D-09E3408E9956}"
              SQLTask:SqlStatementSource="INSERT INTO [DW].[kharazmi].[FactFinance]&#xA;SELECT * FROM &#xA;(&#xA;SELECT&#xA;Voucherid,&#xA;VoucherItemid,&#xA;    d.datekey,  &#xA;&#x9;--FiscalDateID = D.FiscalDateID,&#xA;&#x9;AccountingVoucherTypeID = H.VoucherTypeRef,&#xA;&#x9;AccountingVoucherStateID = H.State,&#xA;&#x9;BranchID = H.BranchRef,&#xA;&#x9;AccountID = CAST(SL.code AS bigint),&#xA;&#x9;DL4ID =  DL.DLID  ,&#xA;&#x9;DL5ID = ISNULL(CAST(DL5.DLID AS bigint),0),&#xA;&#x9;DL6ID = ISNULL(CAST(DL6.DLID AS bigint),0),&#xA;&#x9;Debit = ISNULL(I.Debit,0),&#xA;&#x9;Credit = ISNULL(I.Credit,0),&#xA;&#x9;DebitBalance = (ISNULL(I.Debit,0) - ISNULL(I.Credit,0))&#xA;&#x9;--select count(*)&#xA;FROM [kharazmi].[FIN3VoucherItem]I&#xA;&#xA;--LEFT JOIN dbo.ViewSystem S ON S.Code = VT.OwnerSystem&#xA;JOIN&#x9;[kharazmi].[FIN3Voucher] H  ON H.VoucherID = I.VoucherRef&#xA;&#xA;JOIN [kharazmi].[FIN3VoucherType] VT ON VT.VoucherTypeID = H.VoucherTypeRef&#xA;--JOIN&#x9;MRS3.DimDate D ON H.Date = D.FullDate&#xA; JOIN&#x9;[kharazmi].[FIN3SL] SL ON I.SLRef = SL.SLID&#xA;LEFT JOIN  [kharazmi].[FIN3DL] DL ON DL.code = I.DLLevel4 COLLATE DATABASE_DEFAULT &#xA;LEFT JOIN [kharazmi].[FIN3DL] DL5 ON DL5.Code = I.DLLevel5 COLLATE DATABASE_DEFAULT &#xA;LEFT JOIN [kharazmi].[FIN3DL] DL6 ON DL6.Code = I.DLLevel6 COLLATE DATABASE_DEFAULT &#xA;join (select * from dw..dimdate)d on d.Date= h.Date&#xA;&#xA;    WHERE H.State &lt;&gt; 2 &#xA;&#xA;        AND (h.isupdate = 1 OR i.isupdate = 1)&#xA;) a" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
