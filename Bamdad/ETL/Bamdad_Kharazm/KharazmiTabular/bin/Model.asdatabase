          },
          {
            "name": "pakhs",
            "expression": [
              "",
              "IF(",
              "    SELECTEDVALUE(dimcustomer[CustomerID]) ",
              "        IN { 27000,12000, 69238, 20000, 24000, 69254, 48000, 1000, 29000, 47000, 42000, 69319, 69257, 69316, 69219, 52000 },",
