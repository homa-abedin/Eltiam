      {
        "name": "FactInventoryWeb",
        "columns": [
          {
            "name": "datekey",
            "dataType": "int64",
            "sourceColumn": "datekey"
          },
          {
            "name": "productcode",
            "dataType": "double",
            "sourceColumn": "productcode"
          },
          {
            "name": "centerid",
            "dataType": "int64",
            "sourceColumn": "centerid"
          },
          {
            "name": "BatchNo",
            "dataType": "int64",
            "sourceColumn": "BatchNo"
          },
          {
            "name": "ExpDate",
            "dataType": "dateTime",
            "sourceColumn": "ExpDate"
          },
          {
            "name": "QtyStock",
            "dataType": "int64",
            "sourceColumn": "QtyStock"
          },
          {
            "name": "InWay",
            "dataType": "int64",
            "sourceColumn": "InWay"
          },
          {
            "name": "QtystockPrice",
            "dataType": "double",
            "sourceColumn": "QtystockPrice"
          },
          {
            "name": "pakhsh",
            "dataType": "string",
            "sourceColumn": "pakhsh"
          },
          {
            "name": "valuepakhsh",
            "dataType": "int64",
            "sourceColumn": "valuepakhsh"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/192 168 10 10;DW\",",
                "    kharazmi_FactInventoryWeb = Source{[Schema=\"kharazmi\",Item=\"FactInventoryWeb\"]}[Data]",
                "in",
                "    kharazmi_FactInventoryWeb"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "QuantityStock",
            "expression": [
              " VAR dat= max(DimDate[datekey])",
              "RETURN CALCULATE(sum(FactInventoryWeb[QtyStock]) , FactInventoryWeb[datekey]= dat)"
            ],
            "formatString": "#,##0",
            "lineageTag": "85fe6c92-39fd-4664-98ba-e0d4a97518b5"
          },
          {
            "name": "QuantityInWay",
            "expression": [
              " VAR dat= max(DimDate[datekey])",
              "RETURN CALCULATE(sum(FactInventoryWeb[InWay]) , FactInventoryWeb[datekey]= dat)"
            ],
            "formatString": "#,##0",
            "lineageTag": "ebec7a9d-3211-4b1c-9167-a62d71adf737"
          },
          {
            "name": "StockPrice",
            "expression": [
              " VAR dat= max(DimDate[datekey])",
              "var kol= CALCULATE(sumx(FactInventoryWeb,FactInventoryWeb[QtystockPrice]*FactInventoryWeb[Qtystock])",
              " , FactInventoryWeb[datekey]= dat)",
              "return divide (kol, 10000000)"
            ],
            "formatString": "#,##0",
            "lineageTag": "05b7e960-9ead-4e55-8fe8-bd9d5b20ac8f"
          },
          {
            "name": "CountofProduct Inventory",
            "expression": [
              " ",
              "CALCULATE(",
              "    COUNTROWS(DISTINCT(FactInventoryWeb[productcode]))",
              "    , FactInventoryWeb[datekey]= max(DimDate[datekey]), (FactInventoryWeb[QtyStock]>0 || FactInventoryWeb[InWay]>0)",
              ")",
              "    "
            ],
            "lineageTag": "77aa5301-c6e4-48d4-863d-02ee794dba62"
          },
          {
            "name": "CountofSKUInventory",
            "expression": [
              " ",
              "CALCULATE(",
              "    COUNTROWS(DISTINCT(FactInventoryWeb[BatchNo]))",
              "    ",
              "    , FactInventoryWeb[datekey]= max(DimDate[datekey]), (FactInventoryWeb[QtyStock]>0 || FactInventoryWeb[InWay]>0)",
              ")"
            ],
            "lineageTag": "f5c90a10-fef2-4a7c-9f02-e5d09364e5cf"
          },
          {
            "name": "ExpiringIn15Months",
            "expression": [
              " ",
              "CALCULATE(",
              "    COUNTROWS(DISTINCT(FactInventoryWeb[BatchNo])),",
              "        FactInventoryWeb[ExpDate] <= EDATE(TODAY(), 15)",
              "    , FactInventoryWeb[datekey]= max(DimDate[datekey]), (FactInventoryWeb[QtyStock]>0 || FactInventoryWeb[InWay]>0)",
              ")"
            ],
            "lineageTag": "cad86fd3-1be1-4da2-ab33-e065b26d82ae"
          },
          {
            "name": "ExpiringStockValue",
            "expression": [
              " ",
              "CALCULATE(",
              "    [StockPrice],",
              "     FactInventoryWeb[ExpDate] <= EDATE(TODAY(), 15)",
              "    , FactInventoryWeb[datekey]= max(DimDate[datekey]), (FactInventoryWeb[QtyStock]>0 || FactInventoryWeb[InWay]>0)",
              ")"
            ],
            "lineageTag": "01f9c4e3-50d4-415d-aac4-b480d64e4184"
          },
          {
            "name": "Ratio of monghazi be kol",
            "expression": " DIVIDE([ExpiringIn15Months], [CountofSKUInventory])",
            "formatString": "#,##0 %",
            "lineageTag": "a02e1963-d177-4f34-bbe9-5cfaf6c21ca9"
          },
          {
            "name": "RAtio of monghazi to rial mojodi",
            "expression": " DIVIDE([ExpiringStockValue], [StockPrice])",
            "formatString": "#,##0 %",
            "lineageTag": "04ce3dd4-4531-4eb9-8007-1af41778b0a6"
          },
          {
            "name": "RemainExpirationMonth",
            "expression": [
              "",
              "VAR ExpDate = MIN(FactInventoryWeb[ExpDate])   ",
              "VAR x = DATEDIFF(TODAY(), ExpDate, MONTH)      ",
              "VAR MinExpDateForProduct = ",
              "   calculate(min(FactInventoryWeb[ExpDate]), FactInventoryWeb[ExpDate]<>DATE(2000,1,1) )",
              "",
              "VAR MinMonthRemaining = DATEDIFF(TODAY(), MinExpDateForProduct, MONTH)  ",
              "",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    ISINSCOPE(dimproduct[FullName Product]) && NOT ISINSCOPE(FactInventoryWeb[BatchNo]), ",
              "        MinMonthRemaining, ",
              "    ISINSCOPE(FactInventoryWeb[BatchNo]), ",
              "        x, ",
              "    0 ",
              ")",
              "",
              " "
            ],
            "lineageTag": "a025e1c9-1262-44b3-8543-e22b95b67513"
          },
          {
            "name": "ColorInventory",
            "expression": [
              "",
              "VAR ExpDate = MIN(FactInventoryWeb[ExpDate])",
              "VAR RemainMonth = DATEDIFF(TODAY(), ExpDate, MONTH)",
              "VAR HasNearExpiryBatch =",
              "    CALCULATE(",
              "        COUNTROWS(distinct (FactInventoryWeb[BatchNo])),",
              "        FactInventoryWeb[ExpDate] <= EDATE(TODAY(), 15), FactInventoryWeb[Qtystock]>0",
              "        ,ALLEXCEPT(dimproduct, dimproduct[FullName Product]),FactInventoryWeb[ExpDate] <> DATE(2000,1,1)",
              "        )",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    ISBLANK(ExpDate)",
              "    , \"#6A9C89\",      ",
              "    ISINSCOPE(dimproduct[FullName Product])&& NOT ISINSCOPE(FactInventoryWeb[BatchNo]) && HasNearExpiryBatch > 0, \"#C80000\", ",
              "    ISINSCOPE(FactInventoryWeb[BatchNo]) && RemainMonth <= 15, \"#C80000\", ",
              "",
              "    \"#6A9C89\" ",
              ")",
              ""
            ],
            "lineageTag": "6f00acdc-5fac-44c1-81d1-54f98226bf94"
          },
          {
            "name": "NearExpirationDate",
            "expression": [
              "",
              "VAR MinExpDateForProduct = ",
              "   calculate(min(FactInventoryWeb[ExpDate]), FactInventoryWeb[ExpDate]<>DATE(2000,1,1) )",
              "",
              "",
              "",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    ISINSCOPE(dimproduct[FullName Product]) && NOT ISINSCOPE(FactInventoryWeb[BatchNo]), ",
              "        MinExpDateForProduct, ",
              "    ISINSCOPE(FactInventoryWeb[BatchNo]), ",
              "       min( FactInventoryWeb[ExpDate]), ",
              "    DATE(2000,1,1) ",
              ")",
              ""
            ],
            "lineageTag": "d25d399a-388a-43a1-99bb-7f7ea7c074de"
          }
        ]
      }
    ],
