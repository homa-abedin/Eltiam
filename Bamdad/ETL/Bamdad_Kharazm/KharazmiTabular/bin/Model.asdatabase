          {
            "name": "BahayeTamamshodeDaramadhayeAmaliyati",
            "expression": [
              "var x =",
              "CALCULATE(",
              "    [01-DebitBalance],",
              "    FactFinance[AccountID] = 7810,",
              "    FILTER(",
              "        FINDescription,",
              "        SEARCH(\"مواد\", FINDescription[description], 1, 0) > 0",
              "    )",
              ")",
              "var y = CALCULATE([01-DebitBalance],FactFinance[AccountID] in {7810,8901})",
              "",
              "return -(y-x)"
            ],
            "displayFolder": "Finance",
            "lineageTag": "d8a3e59e-eda9-4e28-8a69-00084f5e613f"
          },
          {
            "name": "HazinehayeForooshVaEdariVaOmomi",
            "expression": "-CALCULATE([01-DebitBalance], FactFinance[AccountID] in {7102,7103,7104,7105,7106,7107,7110,7113,7114,7115,7116,7117,7119,7120,7121,7122,7123,7124,7127,7129,7130,7133,7134,7135,7136,7137,7138,7139,7142,7199,7201,7203,7205,7206,7208,7209,7210,7211,7214,7215,7216,7217,7301,7302,7303,7304,7305,7306,7307,7308,7309,7310,7311,7312,7313,7314,7315,7316,7317,7318,7319,7320,7321,7323,7324,7325,7326,7327,7328,7329,7331,7332,7333,7335,7336,7337,7338,7340,7343,7345,7346,7350,7354,7358,7360,7361,7362,7366,7367,7368,7369,7370,7371,7372,7373,7410,7420,7430,7440,7450,7460,7470,7480,7490,7491,7530,8906,8908})",
            "displayFolder": "Finance",
            "lineageTag": "da470152-8960-4904-80bf-96bc93311a94"
          },
          {
            "name": "SayereDaramadha",
            "expression": "-CALCULATE([01-DebitBalance],FactFinance[AccountID] in {6212,6216,6299})",
            "displayFolder": "Finance",
            "lineageTag": "991a1b0b-5908-499a-bcdc-442520ee6896"
          },
          {
            "name": "Hazinehaye Mali",
            "expression": "-CALCULATE([01-DebitBalance], FactFinance[AccountID] in {7510,7520,7525})",
            "displayFolder": "Finance",
            "lineageTag": "ef2053ce-ca65-4e67-a439-ec0e658eb8f7"
          },
          {
            "name": "SayerDaramadhaVaHazinehayeGheireAmaliyati",
            "expression": "-CALCULATE([01-DebitBalance],FactFinance[AccountID] in {6319})",
            "displayFolder": "Finance",
            "lineageTag": "b546a0bf-e4f7-4b16-bdc4-3f37df1cd865"
          },
          {
            "name": "SoodAmaliyatdarhaleTadavomGhabl az Maliyat",
            "expression": [
              " var x =",
              "CALCULATE(",
              "    [01-DebitBalance],",
              "    FactFinance[AccountID] = 7810,",
              "    FILTER(",
              "        FINDescription,",
              "        SEARCH(\"مواد\", FINDescription[description], 1, 0) > 0",
              "    )",
              ")",
              " var y = CALCULATE([01-DebitBalance], FactFinance[AccountID] in {6210,6211})",
              " var z= CALCULATE([01-DebitBalance], FactFinance[AccountID] in{6399,6319})",
              " return y+x+z"
            ],
            "displayFolder": "Finance",
            "lineageTag": "485dce3a-4bf8-4926-bea2-f72410cd698b"
          },
          {
            "name": "HazineMaliyatBarDaramadSaleJari",
            "expression": "(CALCULATE([01-DebitBalance], FactFinance[AccountID]  in {6319,3212}) * 20) /100",
            "displayFolder": "Finance",
            "lineageTag": "172c7603-73e0-40d2-8510-ec758b82728a"
          },
          {
            "name": "SoodNakhales",
            "expression": "[DaramadAmaliyati]+[BahayeTamamshodeDaramadhayeAmaliyati]",
            "displayFolder": "Finance",
            "lineageTag": "836f983e-af55-4efd-8d24-c3c572b5c42e"
          },
          {
            "name": "MojodiMavadVaKala",
            "expression": " CALCULATE([01-DebitBalance],FactFinance[AccountID] IN {1495,1510,1511,1520,1524,1525,1535,1536,1545,1578,1592})",
            "displayFolder": "Finance",
            "lineageTag": "6886220b-7fab-4d1e-b1e7-2af92da289f4"
          },
          {
            "name": "AndookhteGhanooni",
            "expression": "-CALCULATE([01-DebitBalance],FactFinance[AccountID] = 5210)",
            "displayFolder": "Finance",
            "lineageTag": "24ad0436-0376-48f9-aa22-1aaa275d00b3"
          },
          {
            "name": "DaraeJari",
            "expression": "[Pishpardakhtaha]+[MojodiMavadVaKala]+[DaryaftanihayeTejariVaSayereDaryaftaniha]+[MojodiNaghd]",
            "displayFolder": "Finance",
            "lineageTag": "5a143c38-641a-4c88-857c-c22b6df1fb50"
          },
          {
            "name": "Darae",
            "expression": "[DaraeJari]+[DaraehayeGheireJari]",
            "displayFolder": "Finance",
            "lineageTag": "dd6f5854-12a8-43d4-8a98-2fb8b3d56394"
          },
          {
            "name": "HoghoghMalekane",
            "expression": "[Sarmayeh]+[AndookhteGhanooni]+[SoodeAnbashte]",
            "displayFolder": "Finance",
            "lineageTag": "4b5e3dbf-a20e-4d3a-a118-a9c4fa1cc9c1"
          },
          {
            "name": "SayerHazine",
            "expression": "CALCULATE([01-DebitBalance],FactFinance[AccountID] in {6399,7810})",
            "displayFolder": "Finance",
            "lineageTag": "ea5b9e47-d672-4727-8a7d-7124d95623d2"
          },
          {
            "name": "SoodAmaliyati",
            "expression": "[SoodNakhales]+[HazinehayeForooshVaEdariVaOmomi]+[SayereDaramadha]+[SayerHazine]",
            "displayFolder": "Finance",
            "lineageTag": "cd36f59a-55d6-4d8b-8581-f0f4d451092d"
          },
          {
            "name": "SoodAmaliyatDarHalTadavomGhablazMaliyat",
            "expression": "[SoodAmaliyati]+[Hazinehaye Mali]+[SayerDaramadhaVaHazinehayeGheireAmaliyati]-1",
            "displayFolder": "Finance",
            "lineageTag": "76d5941e-cc34-455e-9020-481c1ef89c58"
          },
          {
            "name": "SoodKhalesAmaliyatDarhalTadavom",
            "expression": "[SoodAmaliyatDarHalTadavomGhablazMaliyat]+[HazineMaliyatBarDaramadSaleJari]",
            "displayFolder": "Finance",
            "lineageTag": "a67c5b19-8029-4004-bc64-9e3b929996da"
          },
          {
            "name": "DaramadAmaliyati_LastYear",
            "expression": [
              "CALCULATE(ABS([DaramadAmaliyati]),",
              " USERELATIONSHIP ('FactFinance'[DateID] , 'DimDate'[LastYearDateKey] )",
              ")"
            ],
            "displayFolder": "Finance",
            "lineageTag": "668c240c-d4f8-4b48-b500-48fe3cccd75d"
          }
        ]
      },
