          {
            "type": "calculated",
            "name": "New Product",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": " if(DATEDIFF(TODAY(),dimproduct[ParvaneDate],day)<=1095, 1,0)"
          },
          {
            "type": "calculated",
            "name": "FullName Product",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "CONCATENATE( dimproduct[name], dimproduct[Number])"
          },
          {
